{
  "permissions": {
    "deny": [
      "Read(./docs/release-repo/site/**)",
      "Read(./artifacts/**)",
      "Read(./src/Yrk.PdfStudio.App/Assets/Guide/**)",
      "Read(./**/bin/**)",
      "Read(./**/obj/**)"
    ],
    "allow": [
      "Bash(codex exec:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-notes-check.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
