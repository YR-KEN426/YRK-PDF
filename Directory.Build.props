<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>YRK LAB</Company>
    <Product>YRK PDF</Product>
    <Copyright>© 2026 YRK LAB</Copyright>
    <Version>1.2.2</Version>
  </PropertyGroup>
  <!-- .NET analyzers (pre-Store audit, layer 1): recommended rules plus every security rule, as warnings only.
       latest-all is avoided on purpose: thousands of style warnings would bury the security ones. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
  </PropertyGroup>
  <!-- Test method names use underscores (Method_Case_Result) by convention. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Yrk.PdfStudio.Core.Tests'">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>
