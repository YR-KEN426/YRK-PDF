<Project Sdk="Microsoft.NET.Sdk">

  <!-- Creates YRK's update-signing key and signs release packages (see build\release.ps1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the signature code, so the tool stays small and builds fast. -->
    <Compile Include="..\..\src\Yrk.PdfStudio.Core\Security\UpdateSignature.cs" Link="UpdateSignature.cs" />
  </ItemGroup>

</Project>
