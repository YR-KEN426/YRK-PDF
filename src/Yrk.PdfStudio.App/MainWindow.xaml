<Window x:Class="Yrk.PdfStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Yrk.PdfStudio.App.ViewModels"
        xmlns:conv="clr-namespace:Yrk.PdfStudio.App.Converters"
        xmlns:ctrl="clr-namespace:Yrk.PdfStudio.App.Controls"
        xmlns:svc="clr-namespace:Yrk.PdfStudio.App.Services"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1280"
        Height="820"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDrop="OnPreviewDrop"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Form widget editors. They live in a canvas measured in PDF points, scaled by a Viewbox. -->
        <!-- Opaque, so the field's own (stale) appearance in the rendered page does not show through. -->
        <SolidColorBrush x:Key="FieldBrush" Color="#E3ECFF" />

        <!-- Untouched fields are see-through, so their saved appearance shows (a reopened file looks as saved);
             typed-in or focused ones are opaque over the stale appearance. -->
        <SolidColorBrush x:Key="FieldTintBrush" Color="#40B9CCFF" />

        <DataTemplate x:Key="TextFieldTemplate" DataType="{x:Type vm:FormFieldViewModel}">
            <!-- Sized along its text and turned like the field, so typed text runs the way it is saved. -->
            <TextBox Width="{Binding TextWidth}" Height="{Binding TextHeight}" FontSize="{Binding FontSize}"
                     FontFamily="{Binding FontFamilyName}" FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="{Binding IsMultiline}"
                     BorderBrush="{StaticResource AccentBrush}" Padding="1,0"
                     GotKeyboardFocus="OnFormFieldFocused" Tag="keep-text">
                <TextBox.LayoutTransform>
                    <RotateTransform Angle="{Binding TextAngle}" />
                </TextBox.LayoutTransform>
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                        <Setter Property="Foreground" Value="{Binding Foreground}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderThickness" Value="0.75" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEdited}" Value="False" />
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource FieldTintBrush}" />
                                <Setter Property="Foreground" Value="Transparent" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <!-- An image field: click to choose a picture, as in Acrobat. -->
        <DataTemplate x:Key="ImageFieldTemplate" DataType="{x:Type vm:FormFieldViewModel}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Button Command="{Binding DataContext.PickFieldImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" Cursor="Hand" Padding="0" BorderThickness="0"
                        ToolTip="Click to choose a picture" AutomationProperties.Name="Choose a picture">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Background="{StaticResource FieldTintBrush}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="#55B9CCFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <!-- Hides the picture saved in the file (still on the page image) once it is removed or replaced. -->
                        <Border Background="White" Visibility="{Binding CoversSavedPicture, Converter={StaticResource BoolToVisibility}}" />
                        <Border Background="White" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" Margin="2" />
                        </Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsPicture}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xEB9F;" FontSize="18" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Click to choose a picture" FontSize="8" Margin="0,3,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" Padding="2" Cursor="Hand"
                        Command="{Binding DataContext.ClearFieldImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" ToolTip="Remove the picture" AutomationProperties.Name="Remove the picture"
                        Visibility="{Binding ShowsPicture, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="7" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxFieldTemplate" DataType="{x:Type vm:FormFieldViewModel}">
            <Border Width="{Binding Width}" Height="{Binding Height}" Background="{StaticResource FieldBrush}">
                <Viewbox Margin="1">
                    <CheckBox IsChecked="{Binding IsChecked}" />
                </Viewbox>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RadioFieldTemplate" DataType="{x:Type vm:FormFieldViewModel}">
            <Border Width="{Binding Width}" Height="{Binding Height}" Background="{StaticResource FieldBrush}">
                <Viewbox Margin="1">
                    <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsChecked}" />
                </Viewbox>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceFieldTemplate" DataType="{x:Type vm:FormFieldViewModel}">
            <ComboBox Width="{Binding Width}" Height="{Binding Height}" FontSize="{Binding FontSize}" Padding="2,0"
                      VerticalContentAlignment="Center" FontFamily="Leelawadee UI, Segoe UI"
                      ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" />
        </DataTemplate>

        <ctrl:FormFieldTemplateSelector x:Key="FieldTemplates"
                                        TextTemplate="{StaticResource TextFieldTemplate}"
                                        CheckBoxTemplate="{StaticResource CheckBoxFieldTemplate}"
                                        RadioButtonTemplate="{StaticResource RadioFieldTemplate}"
                                        ChoiceTemplate="{StaticResource ChoiceFieldTemplate}"
                                        ImageTemplate="{StaticResource ImageFieldTemplate}" />

        <Style x:Key="MoveThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0.8" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A signature, stamp or text box placed on the page (unsaved until File > Save). -->
        <DataTemplate x:Key="PlacedItemTemplate" DataType="{x:Type vm:PlacedItemViewModel}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontFamily="{Binding FontFamily}" Padding="1"
                           FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}" Foreground="{Binding Foreground}" Visibility="{Binding ShowTextPreview, Converter={StaticResource BoolToVisibility}}" />
                <Thumb Style="{StaticResource MoveThumb}"
                       DragStarted="OnItemDragStarted" DragDelta="OnItemMoveDelta" DragCompleted="OnItemDragCompleted"
                       PreviewMouseLeftButtonDown="OnItemMouseDown" ToolTip="Drag to move. Double-click text to edit." />
                <Canvas Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" FontSize="{Binding FontSize}"
                             FontFamily="{Binding FontFamily}" FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}" Foreground="{Binding Foreground}" Padding="0" BorderThickness="0.6" MinWidth="40"
                             BorderBrush="{StaticResource AccentBrush}" Background="#F2FFFFFF" AcceptsReturn="True"
                             IsVisibleChanged="OnTextEditorVisibleChanged" Loaded="OnTextEditorLoaded" LostKeyboardFocus="OnTextEditorLostFocus"
                             PreviewKeyDown="OnTextEditorKeyDown" />
                </Canvas>
                <Rectangle Stroke="{StaticResource AccentBrush}" StrokeThickness="0.8" StrokeDashArray="3 2" IsHitTestVisible="False"
                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                <Thumb Style="{StaticResource ResizeThumb}" Width="7" Height="7" Margin="0,0,-3.5,-3.5"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       DragStarted="OnItemDragStarted" DragDelta="OnItemResizeDelta" DragCompleted="OnItemDragCompleted"
                       Visibility="{Binding ShowResizeHandle, Converter={StaticResource BoolToVisibility}}" ToolTip="Drag to resize" />
                <Button Width="10" Height="10" Margin="0,-12,-12,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{StaticResource AccentBrush}" BorderThickness="0" Cursor="Hand" ToolTip="Remove (Delete)"
                        Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="6" Foreground="White" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- The name under a comment tool's icon, so the tools can be found without hovering. -->
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LabelledTool" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggle}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
        <Style x:Key="CanvasItem" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenExecuted" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveExecuted" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyExecuted" CanExecute="OnCopyCanExecute" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}" />
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding FitPageCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding FitWidthCommand}" />
        <KeyBinding Key="Home" Modifiers="Ctrl" Command="{Binding FirstPageCommand}" />
        <KeyBinding Key="End" Modifiers="Ctrl" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ToggleRulersCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
    </Window.InputBindings>

    <Grid>
    <Grid IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBooleanConverter.Instance}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <!-- Buttons wrap to a second line when the window is narrow, so search always keeps its place. -->
            <Grid Margin="6,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="Show or hide the sidebar" AutomationProperties.Name="Sidebar">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE700;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnHomeClick" ToolTip="Start page: all tools" AutomationProperties.Name="Start page">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE80F;" />
                    </Button>
                    <!-- File and View menus, for people used to Office: every command is also a button or a shortcut. -->
                    <Button x:Name="FileMenuButton" Style="{StaticResource ToolbarButton}" Click="OnFileMenuClick"
                            ToolTip="File: open, save, export, print (Alt+F)" AutomationProperties.Name="File">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="File" Margin="2,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewMenuButton" Style="{StaticResource ToolbarButton}" Click="OnViewMenuClick"
                            ToolTip="View: zoom, sidebar, rulers (Alt+V)" AutomationProperties.Name="View">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="View" Margin="2,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToolsMenuButton" Style="{StaticResource ToolbarButton}" Click="OnToolsButtonClick"
                            ToolTip="Combine, split, compress, images to PDF (Alt+T)" AutomationProperties.Name="Tools">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tools" Margin="2,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsMenuButton" Style="{StaticResource ToolbarButton}" Click="OnSettingsButtonClick"
                            ToolTip="Settings: language, updates, privacy (Alt+S)" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Settings" Margin="2,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HelpMenuButton" Style="{StaticResource ToolbarButton}" Click="OnHelpButtonClick"
                            ToolTip="Help, shortcuts and support (Alt+H)" AutomationProperties.Name="Help">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Help" Margin="2,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <Button Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.Open" ToolTip="Open (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" />
                            <TextBlock Text="Open" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnRecentMenuClick" Padding="3,0" Margin="-2,0,0,0"
                            ToolTip="Recent files" AutomationProperties.Name="Recent files">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.Save" IsEnabled="{Binding CanSave}"
                            ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                            <TextBlock Text="Save" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveAsCommand}" IsEnabled="{Binding HasDocument}"
                            ToolTip="Save a copy (Ctrl+Shift+S)" AutomationProperties.Name="Save as">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE792;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PrintCommand}" IsEnabled="{Binding HasDocument}"
                            ToolTip="Print (Ctrl+P)" AutomationProperties.Name="Print">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE749;" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasDocument}">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" AutomationProperties.Name="Previous page">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70E;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" AutomationProperties.Name="Next page">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" />
                        </Button>
                        <TextBox Style="{StaticResource ToolbarTextBox}" Width="48" Margin="4,0,0,0" TextAlignment="Center"
                                 Text="{Binding PageInput}" KeyDown="OnPageInputKeyDown" GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                                 ToolTip="Go to page" AutomationProperties.Name="Page number" />
                        <TextBlock Text="{Binding PageCountText}" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />

                        <Border Style="{StaticResource ToolbarDivider}" />

                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71F;" />
                        </Button>
                        <ComboBox x:Name="ZoomBox" Width="104" IsEditable="True" VerticalAlignment="Center" Margin="2,0"
                                  ItemsSource="{Binding ZoomPresets}"
                                  Text="{Binding ZoomText, UpdateSourceTrigger=LostFocus}"
                                  KeyDown="OnZoomBoxKeyDown"
                                  DropDownClosed="OnZoomBoxDropDownClosed"
                                  ToolTip="Zoom" AutomationProperties.Name="Zoom" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8A3;" />
                        </Button>
                        <ToggleButton x:Name="HandToggle" Style="{StaticResource ToolbarToggle}" Checked="OnHandToggleChanged" Unchecked="OnHandToggleChanged"
                                      ToolTip="Hand tool (H): drag to move the page. Or hold Space, or drag with the middle mouse button" AutomationProperties.Name="Hand tool">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7C9;" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowRulers}" IsEnabled="{Binding HasDocument}"
                                      ToolTip="Rulers (Ctrl+R): in mm on paper, or in the drawing's units at its scale" AutomationProperties.Name="Rulers">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xED5E;" />
                        </ToggleButton>
                    </StackPanel>
                </WrapPanel>


                <!-- Search -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0" IsEnabled="{Binding HasDocument}">
                    <TextBlock Text="{Binding SearchStatus}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Grid Width="220" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Style="{StaticResource ToolbarTextBox}" Padding="26,4,4,4"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchBoxKeyDown" GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                                 AutomationProperties.Name="Find in document" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="8,0,0,0"
                                   HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="Find in document (Ctrl+F)" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <CheckBox Content="Aa" IsChecked="{Binding MatchCase}" Margin="6,0,2,0" VerticalAlignment="Center" ToolTip="Match case" AutomationProperties.Name="Match case" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding FindPreviousCommand}" ToolTip="Previous result (Shift+F3)" AutomationProperties.Name="Previous result">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70E;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding FindNextCommand}" ToolTip="Next result (F3)" AutomationProperties.Name="Next result">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Secondary toolbar: Comment / Fill & Sign / Pages tabs -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
            <!-- Tools wrap to a second line when the window is narrow, so they never cover the status text or Undo/Redo. -->
            <Grid Margin="6,0" MinHeight="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="50">
                    <TextBlock Text="{Binding StatusMessage}" Margin="10,0,10,0" VerticalAlignment="Center" Width="240" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7A6;" />
                    </Button>
                </StackPanel>


                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton x:Name="CommentTab" GroupName="ToolbarTabs" Content="Comment" Style="{StaticResource ToolbarTab}" IsChecked="True" />
                    <RadioButton x:Name="EditTab" GroupName="ToolbarTabs" Content="Edit" Style="{StaticResource ToolbarTab}"
                                 Checked="OnEditTabChecked" Unchecked="OnEditTabUnchecked" />
                    <RadioButton x:Name="FillSignTab" GroupName="ToolbarTabs" Content="Fill &amp; Sign" Style="{StaticResource ToolbarTab}" />
                    <RadioButton x:Name="PagesTab" GroupName="ToolbarTabs" Content="Pages" Style="{StaticResource ToolbarTab}" />
                    <RadioButton x:Name="MeasureTab" GroupName="ToolbarTabs" Content="Measure" Style="{StaticResource ToolbarTab}"
                                 Checked="OnMeasureTabChecked" Unchecked="OnMeasureTabUnchecked" />
                    <RadioButton x:Name="RedactTab" GroupName="ToolbarTabs" Content="Redact" Style="{StaticResource ToolbarTab}"
                                 Checked="OnRedactTabChecked" Unchecked="OnRedactTabUnchecked" />
                    <Border Style="{StaticResource ToolbarDivider}" Margin="8,0" />

                    <!-- Comment tools -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=CommentTab, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Select and copy text (Ctrl+C), or drag a comment to move it" AutomationProperties.Name="Select text"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Select}}">
                            <StackPanel>
                                <Path Data="M3,1 L3,14 L6.5,10.5 L9,15.5 L11,14.5 L8.5,9.5 L13,9.5 Z" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" Width="16" Height="16" Margin="0,1" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Select" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Highlight text" AutomationProperties.Name="Highlight"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Highlight}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7E6;" Height="18" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Highlight" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Underline text" AutomationProperties.Name="Underline"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Underline}}">
                            <StackPanel>
                                <TextBlock Text="U" FontSize="14" TextDecorations="Underline" Height="18" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Underline" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Strike out text" AutomationProperties.Name="Strikeout"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.StrikeOut}}">
                            <StackPanel>
                                <TextBlock Text="S" FontSize="14" TextDecorations="Strikethrough" Height="18" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Strikeout" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Add a sticky note" AutomationProperties.Name="Note"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Note}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE90A;" Height="18" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Note" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Draw freehand" AutomationProperties.Name="Pen"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Pen}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE76D;" Height="18" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Pen" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Rectangle" AutomationProperties.Name="Rectangle"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Rectangle}}">
                            <StackPanel>
                                <Rectangle Width="16" Height="12" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" Margin="0,3" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Rectangle" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Ellipse" AutomationProperties.Name="Ellipse"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Ellipse}}">
                            <StackPanel>
                                <Ellipse Width="16" Height="12" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" Margin="0,3" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Ellipse" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Tool" Style="{StaticResource LabelledTool}" ToolTip="Arrow" AutomationProperties.Name="Arrow"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Arrow}}">
                            <StackPanel>
                                <Path Data="M1,15 L15,1 M8,1 L15,1 L15,8" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" Width="16" Height="16" Margin="0,1" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Arrow" />
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddTextCommand}" Margin="2,0,0,0" Padding="6,3"
                                ToolTip="Type text anywhere on the page" AutomationProperties.Name="Add text">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8D2;" Height="18" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource ToolLabel}" Text="Add text" />
                            </StackPanel>
                        </Button>

                        <Border Style="{StaticResource ToolbarDivider}" />

                        <Border Width="24" Height="24" CornerRadius="12" Background="{Binding AnnotationBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" Margin="2,0,6,0" VerticalAlignment="Center" ToolTip="Current colour" />
                        <ItemsControl ItemsSource="{x:Static vm:MainViewModel.Palette}" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SwatchButton}" ToolTip="Colour"
                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Background>
                                            <SolidColorBrush Color="{Binding}" />
                                        </Button.Background>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ComboBox ItemsSource="{x:Static vm:MainViewModel.StrokeWidths}" SelectedItem="{Binding StrokeWidth}" Width="74" Margin="8,0,0,0"
                                  VerticalAlignment="Center" ToolTip="Line width (pen and shapes)" AutomationProperties.Name="Line width" ItemStringFormat="{}{0} pt" />
                    </WrapPanel>

                    <!-- Fill & Sign tools -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=FillSignTab, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddTextCommand}"
                                ToolTip="Type text anywhere on the page" AutomationProperties.Name="Add text">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8D2;" />
                                <TextBlock Text="Add text" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SignButton" Style="{StaticResource ToolbarButton}" Click="OnSignButtonClick"
                                ToolTip="Place your signature" AutomationProperties.Name="Sign">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE76D;" />
                                <TextBlock Text="Sign" Margin="6,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding DigitalSignCommand}"
                                ToolTip="Sign with a certificate (digital ID, USB token or .pfx): proves who signed and detects later changes"
                                AutomationProperties.Name="Sign with digital ID">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8D7;" />
                                <TextBlock Text="Digital ID" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding CertifiedCopyCommand}"
                                ToolTip="Stamp a certified true copy (สำเนาถูกต้อง)" AutomationProperties.Name="Certified copy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xEB95;" />
                                <TextBlock Text="สำเนาถูกต้อง" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding StampCommand}"
                                ToolTip="Rubber stamp: approved, received, paid, original, copy, with the date, or your own stamp"
                                AutomationProperties.Name="Stamp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE930;" />
                                <TextBlock Text="Rubber stamp" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarDivider}" />
                        <!-- Create a form: drag a box (or click) on the page with one of these. -->
                        <TextBlock Text="Create form:" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource SecondaryTextBrush}" />
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="FormTools" AutomationProperties.Name="Text field"
                                     ToolTip="Text box: drag a box on the page, or click"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.FieldText}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8D2;" />
                                <TextBlock Text="Text" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="FormTools" AutomationProperties.Name="Long text field"
                                     ToolTip="Text box for several lines (an address, a comment)"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.FieldMultiline}}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8A4;" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="FormTools" AutomationProperties.Name="Check box field"
                                     ToolTip="Check box"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.FieldCheckBox}}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE73A;" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="FormTools" AutomationProperties.Name="Dropdown field"
                                     ToolTip="Dropdown list of choices"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.FieldDropdown}}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="FormTools" AutomationProperties.Name="Signature field"
                                     ToolTip="Signature field: where the signer signs with a digital ID"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.FieldSignature}}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xEC88;" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="FormTools" AutomationProperties.Name="Edit fields" Margin="4,0,0,0"
                                     ToolTip="Edit fields: click a field (new or saved) to rename it, change its choices, or delete it"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.FieldEdit}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" />
                                <TextBlock Text="Edit fields" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <!-- Edit tools -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=EditTab, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="EditTools" IsChecked="True"
                                     ToolTip="Click a line of text to change it" AutomationProperties.Name="Edit text">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" />
                                <TextBlock Text="Edit text" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding RecognizeTextCommand}"
                                ToolTip="Make scanned pages searchable and editable (OCR)" AutomationProperties.Name="Recognize text">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8FF;" />
                                <TextBlock Text="Recognize text (OCR)" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarDivider}" />
                        <TextBlock Text="Click a line, type, then press Enter or click outside it." VerticalAlignment="Center"
                                   Margin="6,0" Foreground="{StaticResource SecondaryTextBrush}" />
                    </WrapPanel>

                    <!-- Measure tools -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=MeasureTab, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="MeasureTools" AutomationProperties.Name="Distance"
                                     ToolTip="Distance: drag from one point to another (hold Shift for 45° steps)"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.MeasureDistance}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xED5E;" />
                                <TextBlock Text="Distance" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="MeasureTools" AutomationProperties.Name="Path"
                                     ToolTip="Length along several points: click each point, double-click or Enter to finish"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.MeasurePerimeter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7B5;" />
                                <TextBlock Text="Path" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="MeasureTools" AutomationProperties.Name="Area"
                                     ToolTip="Area: click the corners, double-click or Enter to finish"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.MeasureArea}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE739;" />
                                <TextBlock Text="Area" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="MeasureTools" AutomationProperties.Name="Count"
                                     ToolTip="Count: click each item (doors, sockets, lights…); click a mark again to remove it"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Count}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9D5;" />
                                <TextBlock Text="Count" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <Border Style="{StaticResource ToolbarDivider}" />

                        <!-- Count: the type being counted, and what to do with the list. -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCounting, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Item type" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox ItemsSource="{Binding CountTypes}" SelectedItem="{Binding CurrentCountType}" Width="150" VerticalAlignment="Center"
                                      AutomationProperties.Name="Count type" ToolTip="What the next clicks count">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CountTypeViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Total, StringFormat={}  ({0})}" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Width="110" Margin="6,0,0,0" VerticalAlignment="Center" Padding="4,2" AutomationProperties.Name="Type name"
                                     ToolTip="Name of this type, for example Door"
                                     Text="{Binding CurrentCountType.Name, UpdateSourceTrigger=LostFocus}" KeyDown="OnCountNameKeyDown" />
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddCountTypeCommand}" Margin="2,0,0,0"
                                    ToolTip="Count another type of item (new colour)" AutomationProperties.Name="New type">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                                    <TextBlock Text="New type" Margin="6,0,2,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Style="{StaticResource ToolbarDivider}" />
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopyCountsCommand}" IsEnabled="{Binding HasCounts}"
                                    ToolTip="Copy the count list (pastes into Excel as a table)" AutomationProperties.Name="Copy count list">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveCountsCommand}" IsEnabled="{Binding HasCounts}"
                                    ToolTip="Save the count list as an Excel workbook" AutomationProperties.Name="Save count list">
                                <TextBlock Text="Save list…" />
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddCountsCommand}" IsEnabled="{Binding HasCounts}"
                                    ToolTip="Keep the marks in the document as comments" AutomationProperties.Name="Add counts to document">
                                <TextBlock Text="Add to document" />
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCountsCommand}" IsEnabled="{Binding HasCounts}"
                                    ToolTip="Remove all count marks" AutomationProperties.Name="Clear counts">
                                <TextBlock Text="Clear" />
                            </Button>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCounting}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <TextBlock Text="Scale" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding MeasureScales}" SelectedItem="{Binding MeasureScale}" Width="150" VerticalAlignment="Center"
                                  AutomationProperties.Name="Scale" ToolTip="From the drawing uses the scale stored in the PDF (CAD exports)" />
                        <ComboBox ItemsSource="{Binding MeasureUnits}" SelectedItem="{Binding MeasureUnit}" Width="60" Margin="6,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Unit" />
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="MeasureTools" AutomationProperties.Name="Calibrate" Margin="4,0,0,0"
                                     ToolTip="Calibrate: drag over a known length and type its real size"
                                     IsChecked="{Binding CurrentTool, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AnnotationTool.Calibrate}}">
                            <TextBlock Text="Calibrate" />
                        </RadioButton>
                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding SnapEnabled}" Margin="4,0,0,0" AutomationProperties.Name="Snap"
                                      ToolTip="Snap to line ends (square) and middles (triangle) of the drawing. Hold Shift for 45° steps instead.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7C9;" />
                                <TextBlock Text="Snap" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Border Style="{StaticResource ToolbarDivider}" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopyMeasurementCommand}" IsEnabled="{Binding HasMeasurements}"
                                ToolTip="Copy the latest result" AutomationProperties.Name="Copy result">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddMeasurementsCommand}" IsEnabled="{Binding HasMeasurements}"
                                ToolTip="Keep the measurements in the document as comments" AutomationProperties.Name="Add to document">
                            <TextBlock Text="Add to document" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearMeasurementsCommand}" IsEnabled="{Binding HasMeasurements}"
                                ToolTip="Remove all measurements" AutomationProperties.Name="Clear measurements">
                            <TextBlock Text="Clear" />
                        </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding MeasureResult}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"
                                   AutomationProperties.Name="Measurement result" />
                    </WrapPanel>

                    <!-- Redaction tools -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=RedactTab, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="RedactTools" IsChecked="True"
                                     ToolTip="Drag over text, images or drawings to mark them for removal" AutomationProperties.Name="Mark area">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7A8;" />
                                <TextBlock Text="Mark area" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding MarkSearchResultsCommand}"
                                ToolTip="Mark every place with the text in the search box (Ctrl+F), on all pages" AutomationProperties.Name="Mark search results">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" />
                                <TextBlock Text="Mark search results" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarDivider}" />
                        <TextBlock Text="{Binding RedactionMarkText}" VerticalAlignment="Center" Margin="6,0,10,0" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearRedactionMarksCommand}"
                                IsEnabled="{Binding HasRedactionMarks}" ToolTip="Remove all marks" AutomationProperties.Name="Clear marks">
                            <TextBlock Text="Clear marks" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,4" Margin="6,0,0,0" Command="{Binding ApplyRedactionsCommand}"
                                IsEnabled="{Binding HasRedactionMarks}" AutomationProperties.Name="Apply redactions"
                                ToolTip="Remove the marked content for good and save the result as a new file">
                            <TextBlock Text="Apply redactions" />
                        </Button>
                    </WrapPanel>

                    <!-- Page tools -->
                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=PagesTab, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource ToolbarButton}" Click="OnRotateLeft"
                                ToolTip="Rotate left (selected pages, or the current page)" AutomationProperties.Name="Rotate left">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="OnRotateRight"
                                ToolTip="Rotate right (selected pages, or the current page)" AutomationProperties.Name="Rotate right">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7AD;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="OnDeletePages"
                                ToolTip="Delete pages" AutomationProperties.Name="Delete pages">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="OnInsertPages"
                                ToolTip="Insert pages from another PDF after the selected page" AutomationProperties.Name="Insert pages">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                                <TextBlock Text="Insert" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="OnExtractPages"
                                ToolTip="Save the selected pages as a new PDF" AutomationProperties.Name="Extract pages">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xEDE1;" />
                                <TextBlock Text="Extract" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Border Background="#FFF4CE" CornerRadius="4" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsPlacing, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PlacementHint}" />
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Width="240" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <Border.Visibility>
                    <MultiBinding Converter="{x:Static conv:AllTrueToVisibilityConverter.Instance}">
                        <Binding Path="IsSidebarOpen" />
                        <Binding Path="HasDocument" />
                    </MultiBinding>
                </Border.Visibility>
                <TabControl BorderThickness="0" Background="Transparent" Padding="0">
                    <TabControl.Resources>
                        <!-- Four tabs fit on one row of the sidebar. -->
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="5,3" />
                            <Setter Property="FontSize" Value="11.5" />
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="Pages">
                        <ListBox x:Name="ThumbnailList"
                                 ItemsSource="{Binding Pages}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Center"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 SelectionMode="Extended"
                                 AllowDrop="True"
                                 SelectionChanged="OnThumbnailSelectionChanged"
                                 PreviewMouseLeftButtonDown="OnThumbnailMouseDown"
                                 PreviewMouseMove="OnThumbnailMouseMove"
                                 DragOver="OnThumbnailDragOver"
                                 Drop="OnThumbnailDrop"
                                 KeyDown="OnThumbnailKeyDown"
                                 ToolTip="Ctrl/Shift-click to select several pages. Drag a page to move it.">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rotate right" Click="OnRotateRight" />
                                    <MenuItem Header="Rotate left" Click="OnRotateLeft" />
                                    <Separator />
                                    <MenuItem Header="Insert pages from file…" Click="OnInsertPages" />
                                    <MenuItem Header="Extract pages…" Click="OnExtractPages" />
                                    <Separator />
                                    <MenuItem Header="Delete pages" Click="OnDeletePages" InputGestureText="Del" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                    <StackPanel Margin="0,6">
                                        <Border Width="{Binding ThumbnailWidth}" Height="{Binding ThumbnailHeight}" Background="White"
                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                            <Image Source="{Binding Thumbnail}" Stretch="Fill"
                                                   Loaded="OnThumbnailLoaded" Unloaded="OnThumbnailUnloaded" />
                                        </Border>
                                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem x:Name="CommentsTab" Header="Comments">
                        <Grid>
                            <ListBox x:Name="CommentList" ItemsSource="{Binding Comments}" SelectedItem="{Binding SelectedComment}"
                                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommentViewModel}">
                                        <StackPanel Margin="2,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" MinWidth="24" MinHeight="22" Padding="4,2"
                                                        ToolTip="Delete" AutomationProperties.Name="Delete comment" Click="OnDeleteComment">
                                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="11" />
                                                </Button>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PageLabel}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="24" Margin="0,4,0,0" Padding="2" BorderBrush="{StaticResource DividerBrush}"
                                                     AutomationProperties.Name="Comment text" LostKeyboardFocus="OnCommentEditorLostFocus" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No comments yet. Use the Comment tools to highlight text, add notes or draw." Margin="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasComments}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="SignaturesTab" Header="Signatures">
                        <Grid>
                            <ListBox ItemsSource="{Binding Signatures}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Signatures">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SignatureInfoViewModel}">
                                        <StackPanel Margin="0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="{Binding Glyph}" Foreground="{Binding StatusBrush}"
                                                           FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="20,2,0,0" FontSize="11" />
                                            <ItemsControl ItemsSource="{Binding Details}" Margin="20,4,0,0" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,1"
                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <WrapPanel Margin="14,4,0,0">
                                                <Button Content="Go to" Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.GoToSignatureCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="Certificate" Style="{StaticResource LinkButton}"
                                                        Visibility="{Binding HasCertificate, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.ShowCertificateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="View signed version" Style="{StaticResource LinkButton}"
                                                        Visibility="{Binding CanViewSignedVersion, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.ViewSignedVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No digital signatures. Use Fill &amp; Sign › Digital ID to sign with a certificate." Margin="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSignatures}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="LayersTab" Header="Layers">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="8,6,4,2" Visibility="{Binding HasLayers, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Show all" Style="{StaticResource LinkButton}" Command="{Binding ShowAllLayersCommand}" />
                                <Button Content="Hide all" Style="{StaticResource LinkButton}" Command="{Binding HideAllLayersCommand}" />
                                <Button Content="Reset" Style="{StaticResource LinkButton}" Command="{Binding ResetLayersCommand}"
                                        ToolTip="Back to the visibility the file opened with" />
                                <Button Content="Save as default" Style="{StaticResource LinkButton}" Command="{Binding SaveLayerDefaultsCommand}"
                                        ToolTip="Open the file with this visibility from now on (applied when you save)" />
                            </WrapPanel>
                            <Grid>
                                <ListBox ItemsSource="{Binding Layers}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Layers">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LayerViewModel}">
                                            <CheckBox Margin="{Binding Indent}" IsChecked="{Binding IsVisible}" IsEnabled="{Binding CanToggle}"
                                                      AutomationProperties.Name="{Binding Name}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="This document has no layers. PDFs exported from AutoCAD, Illustrator, InDesign or Visio with layers show them here.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLayers}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Bookmarks">
                        <Grid>
                            <TreeView ItemsSource="{Binding Bookmarks}" Background="Transparent" BorderThickness="0"
                                      SelectedItemChanged="OnBookmarkSelected">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:BookmarkViewModel}" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" Padding="2,3" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <TextBlock Text="This document has no bookmarks." Margin="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBookmarks}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Pages, with the signature status above them. -->
            <DockPanel Grid.Column="1">
            <!-- Open files, one tab each (shown once a second file is open). -->
            <Border x:Name="TabStripBar" DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnNewTabClick" Padding="8,2" Margin="2" Background="Transparent" BorderThickness="0"
                            ToolTip="Open in new tab" AutomationProperties.Name="Open in new tab">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TabStrip" Focusable="False">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding TabTitle}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseUp="OnTabClick" Padding="10,5,4,5" MaxWidth="240" Cursor="Hand"
                                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0"
                                            ToolTip="{Binding DocumentPath}" AutomationProperties.Name="{Binding TabTitle}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E6E6E6" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                                                        <Setter Property="Background" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Click="OnTabCloseClick" Padding="4,1" Margin="6,0,0,0"
                                                    Background="Transparent" BorderThickness="0" Focusable="False"
                                                    ToolTip="Close tab" AutomationProperties.Name="Close tab">
                                                <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="10" />
                                            </Button>
                                            <TextBlock Text="{Binding TabTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="#E8F3FC" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,5"
                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart to update" Style="{StaticResource PrimaryButton}" Padding="10,3"
                            Command="{Binding RestartToUpdateCommand}" AutomationProperties.Name="Restart to update" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding UpdateReadyText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,5"
                    Visibility="{Binding ShowSignatureBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Signature panel" Style="{StaticResource SecondaryButton}" Padding="10,3"
                            Command="{Binding ShowSignaturePanelCommand}" AutomationProperties.Name="Signature panel" />
                    <TextBlock Style="{StaticResource IconText}" Text="{Binding BannerSample.Glyph}" Foreground="{Binding BannerSample.StatusBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SignatureBannerText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Rulers (View › Rulers, Ctrl+R) along the page view, in the units of the page under the cursor. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Width="22" Height="22" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,1"
                        Cursor="Hand" MouseLeftButtonUp="OnRulerCornerClick" AutomationProperties.Name="Ruler unit and scale"
                        Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding RulerUnitTip}">
                    <TextBlock Text="{Binding RulerUnit}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" AutomationProperties.Name="Ruler unit" />
                </Border>
                <ctrl:Ruler x:Name="TopRuler" Grid.Column="1" Height="22" Orientation="Horizontal" AutomationProperties.Name="Horizontal ruler"
                            Background="{StaticResource ToolbarBrush}" Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVisibility}}" />
                <ctrl:Ruler x:Name="LeftRuler" Grid.Row="1" Width="22" Orientation="Vertical" AutomationProperties.Name="Vertical ruler"
                            Background="{StaticResource ToolbarBrush}" Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVisibility}}" />

            <!-- Padding and item margin must equal MainViewModel.PageGap (12). -->
            <ScrollViewer x:Name="PageScroller" Grid.Row="1" Grid.Column="1"
                          Background="{StaticResource ViewerBrush}"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Auto"
                          Focusable="True"
                          FocusVisualStyle="{x:Null}"
                          ScrollChanged="OnPageScrollerScrollChanged"
                          MouseLeave="OnPageScrollerMouseLeave"
                          PreviewMouseDown="OnPageScrollerPreviewMouseDown"
                          PreviewMouseMove="OnPageScrollerPreviewMouseMove"
                          PreviewMouseUp="OnPageScrollerPreviewMouseUp"
                          LostMouseCapture="OnPageScrollerLostMouseCapture"
                          PreviewMouseWheel="OnPageScrollerPreviewMouseWheel">

                <ItemsControl x:Name="PageItems" ItemsSource="{Binding Pages}" Padding="12,12,12,0" HorizontalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Margin="0,0,0,12" Background="White"
                                  MouseLeftButtonDown="OnPageMouseLeftButtonDown"
                                  MouseMove="OnPageMouseMove"
                                  MouseLeftButtonUp="OnPageMouseLeftButtonUp"
                                  LostMouseCapture="OnPageLostMouseCapture"
                                  MouseRightButtonUp="OnPageMouseRightButtonUp">
                                <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- At very high zoom: the visible part, rendered sharply over the capped page image. -->
                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                    <Image Source="{Binding DetailImage}" Stretch="Fill" Canvas.Left="{Binding DetailRect.X}" Canvas.Top="{Binding DetailRect.Y}"
                                           Width="{Binding DetailRect.Width}" Height="{Binding DetailRect.Height}" />
                                </Canvas>
                                <Viewbox Stretch="Fill" Opacity="0.4" IsHitTestVisible="False"
                                         Visibility="{Binding HasHighlights, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Highlights}" Width="1000" Height="1000">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HighlightViewModel}">
                                                <Rectangle Width="{Binding Width}" Height="{Binding Height}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="{StaticResource SearchHighlightBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource CurrentSearchHighlightBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>

                                <!-- Form fields and placed items, in PDF points scaled to the page. -->
                                <Viewbox Stretch="Fill">
                                    <Grid Width="{Binding WidthPoints}" Height="{Binding HeightPoints}" TextOptions.TextFormattingMode="Ideal">
                                        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplateSelector="{StaticResource FieldTemplates}"
                                                      ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False"
                                                      IsHitTestVisible="{Binding DataContext.IsEditingFields, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:InverseBooleanConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PlacedItemTemplate}"
                                                      ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding TextEdits}" ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:TextEditViewModel}">
                                                    <Grid MinHeight="{Binding Height}">
                                                        <!-- Covers the old line until the change is written into the page (Enter, a click outside, or Save). -->
                                                        <Border Background="White" Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                        <TextBlock Text="{Binding Text}" Background="White" VerticalAlignment="Center" MinWidth="{Binding Width}"
                                                                   FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}"
                                                                   FontStyle="{Binding FontStyle}" Foreground="{Binding Foreground}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" Background="White" Padding="0" Margin="0" MinWidth="{Binding Width}"
                                                                 BorderThickness="0.5" BorderBrush="{StaticResource AccentBrush}" VerticalContentAlignment="Center"
                                                                 FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}"
                                                                 FontStyle="{Binding FontStyle}" Foreground="{Binding Foreground}" AutomationProperties.Name="Line text"
                                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                                 IsVisibleChanged="OnLineEditorVisibleChanged" Loaded="OnLineEditorLoaded" PreviewKeyDown="OnLineEditorKeyDown"
                                                                 LostKeyboardFocus="OnLineEditorLostFocus" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Count marks: a numbered dot per item, the same size on screen at any zoom. -->
                                        <ItemsControl ItemsSource="{Binding CountMarks}" ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CountMarkViewModel}">
                                                    <!-- Centred on the point and kept the same size on screen with one render transform:
                                                         a layout transform would clip the part moved left and up. -->
                                                    <Border>
                                                        <Border.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform X="-11" Y="-11" />
                                                                <ScaleTransform ScaleX="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                ScaleY="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </TransformGroup>
                                                        </Border.RenderTransform>
                                                        <Grid Width="22" Height="22">
                                                            <Ellipse Fill="{Binding Brush}" Stroke="White" StrokeThickness="1.5" Opacity="0.9" />
                                                            <TextBlock Text="{Binding Number}" Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Measurements}" Focusable="False" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MeasurementViewModel}">
                                                    <Canvas>
                                                        <Path Data="{Binding Geometry}" Stroke="#E8590C" StrokeLineJoin="Round"
                                                              StrokeThickness="{Binding DataContext.MeasureStroke, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsArea}" Value="True">
                                                                            <Setter Property="Fill" Value="#30E8590C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <!-- Clicking the label selects the measurement: it turns dark and its corners get handles. -->
                                                        <Border Canvas.Left="{Binding LabelLeft}" Canvas.Top="{Binding LabelTop}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#E8590C" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#9A3412" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.LayoutTransform>
                                                                <ScaleTransform ScaleX="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                ScaleY="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </Border.LayoutTransform>
                                                            <TextBlock Text="{Binding Result}" Foreground="White" FontSize="12" Margin="6,2" />
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Handles}" ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False"
                                                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:MeasureHandle}">
                                                                    <Rectangle Width="9" Height="9" Fill="White" Stroke="#9A3412" StrokeThickness="1.5">
                                                                        <Rectangle.RenderTransform>
                                                                            <TransformGroup>
                                                                                <TranslateTransform X="-4.5" Y="-4.5" />
                                                                                <ScaleTransform ScaleX="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                ScaleY="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                            </TransformGroup>
                                                                        </Rectangle.RenderTransform>
                                                                    </Rectangle>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Changes waiting for Save on fields already in the document. -->
                                        <ItemsControl ItemsSource="{Binding ChangedFields}" ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FieldChangeViewModel}">
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                        <Rectangle StrokeThickness="1" StrokeDashArray="3 2">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="#30E8590C" />
                                                                    <Setter Property="Stroke" Value="#E8590C" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                                                            <Setter Property="Fill" Value="#50C42B1C" />
                                                                            <Setter Property="Stroke" Value="#C42B1C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                        <Path Data="M0,0 L1,1 M1,0 L0,1" Stretch="Fill" Stroke="#C42B1C" StrokeThickness="1"
                                                              Visibility="{Binding IsDelete, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- New form fields, until the document is saved. -->
                                        <ItemsControl ItemsSource="{Binding NewFields}" ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FormFieldDraftViewModel}">
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Label}">
                                                        <Rectangle Fill="#201C64A8" Stroke="#1C64A8" StrokeThickness="0.8" StrokeDashArray="3 2" />
                                                        <TextBlock Text="{Binding Label}" Foreground="#1C64A8" FontSize="7" Margin="2,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                                                   Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Width="8" Height="8" Margin="0,-4,-4,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="#1C64A8" BorderThickness="0" Cursor="Hand" ToolTip="Remove this field"
                                                                Command="{Binding DataContext.RemoveNewFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="5" Foreground="White" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding RedactionMarks}" ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:RedactionMarkViewModel}">
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                        <Rectangle Fill="#40C42B1C" Stroke="#C42B1C" StrokeThickness="0.8" StrokeDashArray="3 2" />
                                                        <Button Width="8" Height="8" Margin="0,-4,-4,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="#C42B1C" BorderThickness="0" Cursor="Hand" ToolTip="Remove this mark"
                                                                Command="{Binding DataContext.RemoveRedactionMarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="5" Foreground="White" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Canvas IsHitTestVisible="False">
                                            <Path Data="{Binding Preview}" Fill="{Binding PreviewFill}" Stroke="{Binding PreviewStroke}"
                                                  StrokeThickness="{Binding PreviewThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Path Data="{Binding SnapMarker}" Stroke="#00A86B" StrokeThickness="{Binding SnapMarkerThickness}" />

                                            <Rectangle Canvas.Left="{Binding AnnotationSelection.X}" Canvas.Top="{Binding AnnotationSelection.Y}"
                                                       Width="{Binding AnnotationSelection.Width}" Height="{Binding AnnotationSelection.Height}"
                                                       Margin="-2" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" StrokeDashArray="3 2"
                                                       Visibility="{Binding HasAnnotationSelection, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- Corners of a selected shape or drawing: drag one to resize it. -->
                                            <ItemsControl ItemsSource="{Binding AnnotationHandles}" ItemContainerStyle="{StaticResource CanvasItem}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:MeasureHandle}">
                                                        <Rectangle Width="8" Height="8" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5">
                                                            <Rectangle.RenderTransform>
                                                                <TransformGroup>
                                                                    <TranslateTransform X="-4" Y="-4" />
                                                                    <ScaleTransform ScaleX="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    ScaleY="{Binding DataContext.OverlayUnit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                </TransformGroup>
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The one font bar: styles added text, the line being edited, or the form field last clicked
                 (see TextStyleBarViewModel). It floats over the top of the pages so it never crowds the toolbar. -->
            <Border Grid.Row="1" Grid.Column="1" DataContext="{Binding TextStyleBar}" Background="#F2F6FC" CornerRadius="6" Padding="10,4"
                    Margin="0,8,26,0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{x:Static vm:TextStyles.Fonts}" IsEditable="True" Width="150" VerticalAlignment="Center"
                              Text="{Binding FontFamilyName, UpdateSourceTrigger=PropertyChanged}" Tag="keep-text"
                              AutomationProperties.Name="Font" ToolTip="Font (also in the saved file)" />
                    <ComboBox ItemsSource="{Binding SizeChoices}" IsEditable="True" Width="64" Margin="4,0,0,0" VerticalAlignment="Center"
                              Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}" Tag="keep-text"
                              AutomationProperties.Name="Font size" ToolTip="Size in points" />
                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsBold}" Margin="4,0,0,0"
                                  ToolTip="Bold" AutomationProperties.Name="Bold">
                        <TextBlock Text="B" FontWeight="Bold" Width="14" TextAlignment="Center" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsItalic}"
                                  ToolTip="Italic" AutomationProperties.Name="Italic">
                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" Width="14" TextAlignment="Center" />
                    </ToggleButton>
                    <ComboBox ItemsSource="{x:Static vm:TextStyles.Colors}" SelectedItem="{Binding Color}" Width="52" Margin="4,0,0,0"
                              VerticalAlignment="Center" ToolTip="Text colour" AutomationProperties.Name="Text colour">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="18" Height="14" CornerRadius="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding}" />
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                            Command="{Binding DataContext.ApplyFieldStyleToAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding IsFormField, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Use this look in every text field of the form" AutomationProperties.Name="Apply to all fields">
                        <TextBlock Text="Apply to all fields" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Border>
            </Grid>
            </DockPanel>

            <!-- Start page (no document in this tab): open a file, or pick a tool by what you want to do. -->
            <ScrollViewer x:Name="HomePage" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Background="{StaticResource ViewerBrush}">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
            <StackPanel Margin="40,28,26,28" MaxWidth="1264" HorizontalAlignment="Center">
                <DockPanel>
                    <!-- Language, written in both languages so it can be found whichever is shown. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE774;" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <RadioButton x:Name="HomeThai" Style="{StaticResource HomeChip}" Tag="keep-text" Margin="0,0,6,0"
                                     Checked="OnHomeLanguageChecked" AutomationProperties.Name="ไทย (Thai)">
                            <TextBlock Text="ไทย" Tag="keep-text" />
                        </RadioButton>
                        <RadioButton x:Name="HomeEnglish" Style="{StaticResource HomeChip}" Tag="keep-text" Margin="0"
                                     Checked="OnHomeLanguageChecked" AutomationProperties.Name="English">
                            <TextBlock Text="English" Tag="keep-text" />
                        </RadioButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/app.ico" Width="48" Height="48" VerticalAlignment="Center" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="YRK PDF" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="Everything you need for PDFs, in one free program" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Margin="0,14,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E3F1E5" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="Padding" Value="10,3" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </WrapPanel.Resources>
                    <Border><TextBlock Text="✓ Free, for personal and business use" Foreground="#1E6B2F" FontSize="12" /></Border>
                    <Border><TextBlock Text="✓ Works on this computer: files are never uploaded" Foreground="#1E6B2F" FontSize="12" /></Border>
                    <Border><TextBlock Text="✓ No ads, no account" Foreground="#1E6B2F" FontSize="12" /></Border>
                </WrapPanel>

                <!-- Open: the main way in. -->
                <Border Margin="0,20,14,0" Padding="20,16" CornerRadius="10" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Command="ApplicationCommands.Open" Padding="18,8"
                                AutomationProperties.Name="Open file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Open file" Margin="8,0,0,0" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="or drag a file onto this window" FontSize="14" />
                            <TextBlock Text="PDF, and AutoCAD drawings (DWG, DXF) and Illustrator files (AI)" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tools by what people want to do; a card opens a file first when the tool needs one. -->
                <WrapPanel x:Name="HomeCategories" Margin="0,24,0,8">
                    <RadioButton Style="{StaticResource HomeChip}" GroupName="HomeCategory" Tag="all" Content="All tools" IsChecked="True" Checked="OnHomeCategoryChecked" />
                    <RadioButton Style="{StaticResource HomeChip}" GroupName="HomeCategory" Tag="organize" Content="Organize" Checked="OnHomeCategoryChecked" />
                    <RadioButton Style="{StaticResource HomeChip}" GroupName="HomeCategory" Tag="convert" Content="Convert" Checked="OnHomeCategoryChecked" />
                    <RadioButton Style="{StaticResource HomeChip}" GroupName="HomeCategory" Tag="edit" Content="Edit and sign" Checked="OnHomeCategoryChecked" />
                    <RadioButton Style="{StaticResource HomeChip}" GroupName="HomeCategory" Tag="drawings" Content="Construction drawings" Checked="OnHomeCategoryChecked" />
                    <RadioButton Style="{StaticResource HomeChip}" GroupName="HomeCategory" Tag="security" Content="Security" Checked="OnHomeCategoryChecked" />
                </WrapPanel>
                <WrapPanel x:Name="HomeCards" />

                <!-- Recent files (kept only on this computer). -->
                <StackPanel Margin="0,14,14,0" Width="520" HorizontalAlignment="Left">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Count, Source={x:Static svc:RecentFiles.Items}}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding ClearRecentCommand}" Padding="6,2"
                                AutomationProperties.Name="Clear recent files" ToolTip="Clear the list (the files are not touched)">
                            <TextBlock Text="Clear list" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Button>
                        <TextBlock Text="Recent files" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{x:Static svc:RecentFiles.Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:RecentFile}">
                                <Button Style="{StaticResource ToolbarButton}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="8,4"
                                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Path}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                                    <DockPanel Width="488">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- Progress of a long operation (OCR, signing), with Cancel. Outside the disabled area so it stays usable. -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,10" CornerRadius="6"
            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
            Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibility}}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
            <TextBlock Text="{Binding OperationText}" Margin="12,0,16,0" VerticalAlignment="Center" />
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="12,3" Command="{Binding CancelOperationCommand}"
                    AutomationProperties.Name="Cancel operation" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
