<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UI surfaces and foregrounds. PDF paper and document ink stay independent of this palette. -->
    <!-- Preserve the existing blue accent, also used for prompts over white PDF fields. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <!-- Accent used as text/icon on UI surfaces (the fill AccentBrush keeps white text on it). Step 2 moves accent-as-text usages here. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4DA3F0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA3" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0F548C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#181818" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#202020" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#202020" />
    <SolidColorBrush x:Key="ViewerBrush" Color="#101010" />
    <SolidColorBrush x:Key="DividerBrush" Color="#484848" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF9D93" />
    <SolidColorBrush x:Key="HoverBrush" Color="#303030" />
    <SolidColorBrush x:Key="PressedBrush" Color="#383838" />
    <SolidColorBrush x:Key="CheckedBrush" Color="#293F54" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#484848" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#747474" />
    <SolidColorBrush x:Key="BrandBrush" Color="#C62828" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="WarningBannerBrush" Color="#3D321B" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#B88C35" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#85D78B" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="ToolTipMutedTextBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FormSuccessTextBrush" Color="#A3E3AC" />
    <SolidColorBrush x:Key="MeasureTextBrush" Color="#9A3412" />
    <SolidColorBrush x:Key="FormSuccessBackgroundBrush" Color="#203C28" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#484848" />
    <SolidColorBrush x:Key="MeasureAccentBrush" Color="#C2460A" />
    <SolidColorBrush x:Key="InformationBackgroundBrush" Color="#20354A" />
    <SolidColorBrush x:Key="InformationSubtleBrush" Color="#202F40" />
    <!-- The editor uses bound PDF ink (usually dark), so its translucent paper stays light. -->
    <SolidColorBrush x:Key="TextEditorBackgroundBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SignatureBannerBrush" Color="#3D321B" />
    <SolidColorBrush x:Key="PreviewCanvasBrush" Color="#101010" />
    <SolidColorBrush x:Key="PreviewMutedTextBrush" Color="#AFAFAF" />
    <SolidColorBrush x:Key="ScanNoticeTextBrush" Color="#FFE4A1" />
    <SolidColorBrush x:Key="ScanHintTextBrush" Color="#C5CAD3" />
    <SolidColorBrush x:Key="ScanWarningTextBrush" Color="#FFD780" />
    <SolidColorBrush x:Key="ScanPreviewBorderBrush" Color="#747474" />
    <SolidColorBrush x:Key="ScanPanelBorderBrush" Color="#62666D" />
    <SolidColorBrush x:Key="ScanDividerBrush" Color="#35383D" />
    <SolidColorBrush x:Key="ScanOverlayBrush" Color="#EF181818" />
    <SolidColorBrush x:Key="CropLabelBrush" Color="#F0181818" />
    <SolidColorBrush x:Key="ScanPanelBrush" Color="#24272C" />
    <SolidColorBrush x:Key="ScanNoticeBrush" Color="#3D321B" />
    <SolidColorBrush x:Key="SignatureCanvasBorderBrush" Color="#747474" />
    <SolidColorBrush x:Key="RulerTextBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="HomeBackgroundBrush" Color="#101010" />
    <SolidColorBrush x:Key="HomeBorderBrush" Color="#484848" />
    <SolidColorBrush x:Key="HomeBorderStrongBrush" Color="#747474" />
    <SolidColorBrush x:Key="HomeFillBrush" Color="#292929" />
    <SolidColorBrush x:Key="HomeTextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="HomeMutedTextBrush" Color="#C5CAD3" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#AD2222" />
    <SolidColorBrush x:Key="BrandPressedBrush" Color="#961D1D" />
    <SolidColorBrush x:Key="BrandFaintBrush" Color="#302020" />
    <SolidColorBrush x:Key="PdfBadgeTextBrush" Color="#B71C1C" />
    <Color x:Key="HomeShadowColor">#000000</Color>
    <Color x:Key="CalendarTopColor">#FF202020</Color>
    <Color x:Key="CalendarUpperColor">#FF242424</Color>
    <Color x:Key="CalendarLowerColor">#FF282828</Color>
    <Color x:Key="CalendarBottomColor">#FF303030</Color>
    <LinearGradientBrush x:Key="CalendarBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource CalendarTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource CalendarUpperColor}" Offset="0.16" />
        <GradientStop Color="{StaticResource CalendarLowerColor}" Offset="0.16" />
        <GradientStop Color="{StaticResource CalendarBottomColor}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
