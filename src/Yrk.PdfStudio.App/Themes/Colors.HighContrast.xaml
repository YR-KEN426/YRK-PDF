    <SolidColorBrush x:Key="PdfBadgeTextBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <!-- Color is a value type and cannot host DynamicResource expressions. These values are read
         from SystemColors when the dictionary is loaded; brush Color DPs above track live keys. -->
    <x:Static x:Key="HomeShadowColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="CalendarTopColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="CalendarUpperColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="CalendarLowerColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="CalendarBottomColor" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="CalendarBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
</ResourceDictionary>
