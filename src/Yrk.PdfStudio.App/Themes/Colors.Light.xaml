    <SolidColorBrush x:Key="ToolTipMutedTextBrush" Color="#4A5160" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FormSuccessTextBrush" Color="#1E6B2F" />
    <SolidColorBrush x:Key="MeasureTextBrush" Color="#9A3412" />
    <SolidColorBrush x:Key="FormSuccessBackgroundBrush" Color="#E3F1E5" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="MeasureAccentBrush" Color="#CC4E0B" />
