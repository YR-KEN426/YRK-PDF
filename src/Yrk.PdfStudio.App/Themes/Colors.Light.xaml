    <SolidColorBrush x:Key="ScanHintTextBrush" Color="#69707E" />
    <SolidColorBrush x:Key="ScanWarningTextBrush" Color="#8A6500" />
    <SolidColorBrush x:Key="ScanPreviewBorderBrush" Color="#C9CDD4" />
    <SolidColorBrush x:Key="ScanPanelBorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="ScanDividerBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ScanOverlayBrush" Color="#EFFFFFFF" />
