<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand and surface colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA3" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0F548C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ViewerBrush" Color="#E7E7EA" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#616161" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="PressedBrush" Color="#E0E0E0" />
    <!-- Opaque on purpose: the highlight layer gets its transparency as a whole, so overlapping
         per-character rectangles do not stack into darker spots. -->
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="#FFD43B" />
    <SolidColorBrush x:Key="CurrentSearchHighlightBrush" Color="#FF8C00" />

    <SolidColorBrush x:Key="CheckedBrush" Color="#DCE9F7" />

    <!-- New roles are unused until the later migration. Keep today's UI values where available. -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="BrandBrush" Color="#C62828" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="FocusBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="WarningBannerBrush" Color="#FFF4DC" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#CF9B36" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
    <!-- Match SignatureInfoViewModel; invalid status shares the existing error token. -->
    <SolidColorBrush x:Key="SignatureValidBrush" Color="#107C10" />
    <SolidColorBrush x:Key="SignatureWarningBrush" Color="#C17C00" />
    <SolidColorBrush x:Key="SignatureInvalidBrush" Color="#C42B1C" />

    <!-- Start-page brief section 4.1. These pairs are reserved for the new Home cards. -->
    <SolidColorBrush x:Key="OrganizeBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="OrganizeSoftBrush" Color="#FFEDD5" />
    <SolidColorBrush x:Key="ConvertBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="ConvertSoftBrush" Color="#E8EEFF" />
    <SolidColorBrush x:Key="EditBrush" Color="#7E22CE" />
    <SolidColorBrush x:Key="EditSoftBrush" Color="#F3E8FF" />
    <SolidColorBrush x:Key="AccountingBrush" Color="#15803D" />
    <SolidColorBrush x:Key="AccountingSoftBrush" Color="#E6F4EA" />
    <SolidColorBrush x:Key="DrawingsBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="DrawingsSoftBrush" Color="#E0F2F1" />
    <SolidColorBrush x:Key="SecurityBrush" Color="#475569" />
    <SolidColorBrush x:Key="SecuritySoftBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />
</ResourceDictionary>
