<Window x:Class="Yrk.PdfStudio.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About YRK PDF"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <DockPanel>
            <Image Source="/Assets/app.ico" Width="56" Height="56" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="YRK PDF" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                <TextBlock Margin="0,2,0,0">
                    <Run Text="by" Foreground="{StaticResource SecondaryTextBrush}" /> <Run Text="YRK LAB" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /> <Run Text="·" Foreground="{StaticResource SecondaryTextBrush}" /> <Run Text="Your Reliable Kit" FontStyle="Italic" Foreground="{StaticResource SecondaryTextBrush}" />
                </TextBlock>
                <TextBlock Text="© 2026 YRK LAB. All rights reserved." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                <WrapPanel Margin="0,2,0,0">
                    <TextBlock Text="Website:" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,6,0" />
                    <TextBlock x:Name="WebsiteText" />
                </WrapPanel>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,18,0,4" />
        <TextBlock x:Name="SourceText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
        <CheckBox x:Name="AutoCheckBox" Content="Check for updates automatically" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="CheckButton" Content="Check for updates now" Style="{StaticResource SecondaryButton}" Click="OnCheckNow" />
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
        </StackPanel>

        <TextBlock Text="Open-source components" FontWeight="SemiBold" Margin="0,18,0,4" />
        <TextBox x:Name="NoticesText" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="11" Padding="6" AutomationProperties.Name="Licenses" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
