<Window x:Class="Yrk.PdfStudio.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About YRK PDF"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <DockPanel>
            <Image Source="/Assets/app.ico" Width="56" Height="56" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Top" />
            <!-- The developer's logo, introducing the maker: the flask with a Y, "YRK LAB" and the slogan -->
            <Border DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Top" Background="{DynamicResource PaperBrush}" Padding="6" CornerRadius="4">
            <Image Source="/Assets/yrk-lab-slogan.png" Height="104"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="YRK LAB" />
            </Border>
            <StackPanel>
                <TextBlock Text="YRK PDF" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                <TextBlock Margin="0,2,0,0">
                    <Run Text="by" Foreground="{DynamicResource SecondaryTextBrush}" /> <Run Text="YRK LAB" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" /> <Run Text="·" Foreground="{DynamicResource SecondaryTextBrush}" /> <Run Text="Your Reliable Kit" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}" />
                </TextBlock>
                <TextBlock Text="© 2026 YRK LAB. All rights reserved." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                <WrapPanel Margin="0,2,0,0">
                    <TextBlock Text="Website:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                    <TextBlock x:Name="WebsiteText" />
                </WrapPanel>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,18,0,4" />
        <TextBlock x:Name="SourceText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
        <CheckBox x:Name="AutoCheckBox" Content="Check for updates automatically" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="CheckButton" Content="Check for updates now" Style="{StaticResource SecondaryButton}" Click="OnCheckNow" />
            <Button x:Name="RestartButton" Content="Restart to update" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="Collapsed"
                    Click="OnRestartToUpdate" AutomationProperties.Name="Restart to update" />
        </StackPanel>
        <TextBlock x:Name="ResultText" Margin="0,8,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Open-source components" FontWeight="SemiBold" Margin="0,18,0,4" />
        <TextBox x:Name="NoticesText" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="11" Padding="6" AutomationProperties.Name="Licenses" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
