<Window x:Class="Yrk.PdfStudio.App.Views.BackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Back up data" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24">
        <TextBlock Text="Back up data" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Choose the data to save in an encrypted backup file." TextWrapping="Wrap" Margin="0,8,0,14" />
        <StackPanel x:Name="Inputs">
            <CheckBox x:Name="StampsBox" Content="Stamps" IsChecked="True" Margin="0,4" />
            <CheckBox x:Name="SignaturesBox" Content="Signature images" IsChecked="True" Margin="0,4" />
            <CheckBox x:Name="IdsBox" Content="Digital IDs" IsChecked="True" Margin="0,4" />
            <CheckBox x:Name="CertificatesBox" Content="Trusted certificates" IsChecked="True" Margin="0,4" />
            <CheckBox x:Name="ETaxBox" Content="e-Tax settings" IsChecked="True" Margin="0,4" />
            <CheckBox x:Name="SettingsBox" Content="General settings" IsChecked="True" Margin="0,4" />
            <TextBlock Text="Recent files, reading positions, recovery copies, logs and OCR files are excluded." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,14" />
            <TextBlock Text="Backup password (at least 12 characters)" />
            <PasswordBox Style="{StaticResource RevealPasswordStyle}" x:Name="PasswordInput" AutomationProperties.Name="Backup password" Margin="0,5,0,10" Padding="6" MaxLength="1024" />
            <TextBlock Text="Confirm backup password" />
            <PasswordBox Style="{StaticResource RevealPasswordStyle}" x:Name="ConfirmInput" AutomationProperties.Name="Confirm backup password" Margin="0,5,0,12" Padding="6" MaxLength="1024" />
        </StackPanel>
        <Border Background="#FFF4DC" BorderBrush="#CF9B36" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Keep both passwords safe" FontWeight="SemiBold" />
                <TextBlock Text="The backup password cannot be recovered. Remember your Digital ID password too: each .pfx or .p12 file keeps its own password." TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Save backup…" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
