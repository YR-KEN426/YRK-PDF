<Window x:Class="Yrk.PdfStudio.App.Views.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process many files"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Process many files" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12"
                   Text="Do the same job to every file. The originals are not changed: the results are saved as new files in the folder you choose." />

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="150">
                <Button Content="Add files…" Style="{StaticResource SecondaryButton}" Click="OnAddFiles" Margin="0,0,0,6" />
                <Button Content="Add a folder…" Style="{StaticResource SecondaryButton}" Click="OnAddFolder" Margin="0,0,0,6" />
                <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" Margin="2,0,0,10" />
                <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource SecondaryButton}" Click="OnRemove" Margin="0,0,0,6" />
                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Click="OnClear" />
            </StackPanel>
            <ListBox x:Name="FileList" Height="200" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                     AutomationProperties.Name="Files" ToolTip="Drop PDF files or folders here">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="ToolTip" Value="{Binding Path}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <TextBlock x:Name="CountText" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />

        <TextBlock Text="What to do" FontWeight="SemiBold" Margin="0,14,0,4" />
        <StackPanel Margin="12,0,0,0">
            <RadioButton x:Name="PdfAAction" GroupName="Action" Content="Save as PDF/A (for archiving)" IsChecked="True" Checked="OnChanged" />
            <RadioButton x:Name="CompressAction" GroupName="Action" Content="Compress (make the files smaller)" Checked="OnChanged" />
            <RadioButton x:Name="MarksAction" GroupName="Action" Content="Add a watermark, header, footer or page numbers" Checked="OnChanged" />
            <RadioButton x:Name="ProtectAction" GroupName="Action" Content="Protect with a password" Checked="OnChanged" />
            <RadioButton x:Name="ExportAction" GroupName="Action" Content="Export to Word, Excel, images or text" Checked="OnChanged" />
            <RadioButton x:Name="StampAction" GroupName="Action" Content="Rubber stamp (approved, copy, paid …)" Checked="OnChanged" />
        </StackPanel>

        <TextBlock Text="Save the results in" FontWeight="SemiBold" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" Padding="4,3" AutomationProperties.Name="Output folder" TextChanged="OnChanged" />
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Batch error" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Next…" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
