<Window x:Class="Yrk.PdfStudio.App.Views.CertifiedCopyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="สำเนาถูกต้อง (certified copy)"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <TextBlock Text="Certified copy stamp" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Stamp a copy of an ID card or document. Naming the purpose stops the copy from being reused elsewhere."
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,14" TextWrapping="Wrap" />

        <TextBlock Text="ใช้สำหรับ (purpose)" Margin="0,0,0,4" />
        <TextBox x:Name="PurposeInput" Padding="6,5" TextChanged="OnOptionsChanged"
                 ToolTip="For example: สมัครงานบริษัท ABC จำกัด" />
        <TextBlock Text="For example: สมัครงานบริษัท ABC จำกัด. Leave empty to omit." FontSize="11"
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,10" />

        <CheckBox x:Name="DateBox" Content="Include today's date" IsChecked="True" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />

        <TextBlock Text="Signature" Margin="0,12,0,4" />
        <ComboBox x:Name="SignatureChoice" SelectionChanged="OnOptionsChanged" Height="52">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="40">
                        <TextBlock Text="No signature (sign separately)" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding Image}" HorizontalAlignment="Left" Stretch="Uniform" MaxWidth="200" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Preview" Margin="0,14,0,4" />
        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="White" Height="130">
            <Image x:Name="Preview" Stretch="Uniform" Margin="10" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Place stamp" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnPlace" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
