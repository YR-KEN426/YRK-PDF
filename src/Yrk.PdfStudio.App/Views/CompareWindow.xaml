<Window x:Class="Yrk.PdfStudio.App.Views.CompareWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Yrk.PdfStudio.App.ViewModels"
        xmlns:conv="clr-namespace:Yrk.PdfStudio.App.Converters"
        Title="{Binding Title}"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- Page, view and legend -->
        <Border DockPanel.Dock="Top" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page (Page Up)" AutomationProperties.Name="Previous page">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70E;" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding NextPageCommand}" ToolTip="Next page (Page Down)" AutomationProperties.Name="Next page">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" />
                </Button>
                <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="6,0,12,0" />
                <Border Style="{StaticResource ToolbarDivider}" />
                <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="CompareView" Content="Differences" AutomationProperties.Name="Differences"
                             IsChecked="{Binding View, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:CompareView.Differences}}" />
                <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="CompareView" AutomationProperties.Name="First version"
                             IsChecked="{Binding View, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:CompareView.First}}">
                    <TextBlock Text="{Binding FirstName}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolbarToggle}" GroupName="CompareView" AutomationProperties.Name="Second version"
                             IsChecked="{Binding View, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:CompareView.Second}}">
                    <TextBlock Text="{Binding SecondName}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                </RadioButton>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding SwapCommand}" ToolTip="Swap first and second" AutomationProperties.Name="Swap">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8AB;" />
                        <TextBlock Text="Swap" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarDivider}" />
                <Border Width="14" Height="14" Background="#D72828" VerticalAlignment="Center" Margin="4,0,6,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,14,0">
                    <Run Text="Only in" /> <Run Text="{Binding FirstName, Mode=OneWay}" />
                </TextBlock>
                <Border Width="14" Height="14" Background="#146EE6" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,14,0">
                    <Run Text="Only in" /> <Run Text="{Binding SecondName, Mode=OneWay}" />
                </TextBlock>
                <Border Width="14" Height="14" Background="#BBBBBB" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Same" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl + wheel to zoom" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding Summary}" AutomationProperties.Name="Comparison summary" />
            </DockPanel>
        </Border>

        <!-- Changed areas -->
        <DockPanel DockPanel.Dock="Left" Width="230">
            <TextBlock DockPanel.Dock="Top" Text="Changes" FontWeight="SemiBold" Margin="10,8,10,4" />
            <ListBox x:Name="RegionList" ItemsSource="{Binding Regions}" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnRegionSelected" AutomationProperties.Name="Changed areas">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CompareRegionViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="2,3">
                            <TextBlock Text="{Binding Number}" Width="28" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Background="#F3F3F3">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnPreviewMouseWheel" AutomationProperties.AutomationId="CompareScroller">
                <Grid x:Name="Sheet" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                    <Image Source="{Binding Image}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                    <ItemsControl ItemsSource="{Binding Regions}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CompareRegionViewModel}">
                                <Border Width="{Binding Width}" Height="{Binding Height}" BorderBrush="#E8590C"
                                        BorderThickness="{Binding RegionBorder, ElementName=Root}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
            <TextBlock Text="Comparing…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
