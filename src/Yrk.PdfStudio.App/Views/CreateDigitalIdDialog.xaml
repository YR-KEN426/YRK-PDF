<Window x:Class="Yrk.PdfStudio.App.Views.CreateDigitalIdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create a digital ID"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <TextBlock Text="Create a self-signed digital ID" FontSize="16" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,14"
                   Text="Good for internal use. Others will see your identity as unverified unless they trust your ID; for legally recognised signatures use a certificate from a certificate authority." />

        <TextBlock Text="Name" Margin="0,0,0,4" />
        <TextBox x:Name="NameInput" Padding="6,4" AutomationProperties.Name="Name" />
        <TextBlock Text="Email (optional)" Margin="0,10,0,4" />
        <TextBox x:Name="EmailInput" Padding="6,4" AutomationProperties.Name="Email" />
        <TextBlock Text="Organization (optional)" Margin="0,10,0,4" />
        <TextBox x:Name="OrganizationInput" Padding="6,4" AutomationProperties.Name="Organization" />
        <TextBlock Text="Password (protects the ID; asked each time you sign)" Margin="0,10,0,4" />
        <PasswordBox x:Name="PasswordInput" Padding="6,5" AutomationProperties.Name="Password" />
        <TextBlock Text="Confirm password" Margin="0,10,0,4" />
        <PasswordBox x:Name="ConfirmInput" Padding="6,5" AutomationProperties.Name="Confirm password" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Create" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnCreate" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
