<Window x:Class="Yrk.PdfStudio.App.Views.ETaxInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Yrk.PdfStudio.App.Views"
        Title="e-Tax Invoice"
        Width="780"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,4" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Make an e-Tax Invoice" FontSize="16" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,6"
                       Text="The PDF is made as PDF/A-3 with the Revenue Department's XML (ETDA standard) inside. Sign it with your digital ID afterwards, then email it to the buyer." />
            <TextBlock Text="YRK PDF e-Tax status" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2" />
            <TextBlock Text="• Follows ETDA standard ขมธอ. 3-2560, version 2.0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Text="• A sample XML file passed the structure check on the Revenue Department's validation page" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Text="• It has never been tested by actually submitting to the e-Tax Invoice system" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Text="• It is not certified by the Revenue Department" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Text="• YRK PDF is not an e-Tax Invoice service provider. You must check the file and are responsible for submitting it yourself" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="TotalText" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Content="Create e-Tax Invoice" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Document" Style="{StaticResource Label}" />
                        <ComboBox x:Name="TypeInput" AutomationProperties.Name="Document" SelectionChanged="OnTypeChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Number" Style="{StaticResource Label}" />
                        <TextBox x:Name="NumberInput" AutomationProperties.Name="Number" TextChanged="OnChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Date" Style="{StaticResource Label}" />
                        <DatePicker x:Name="DateInput" AutomationProperties.Name="Date" SelectedDateChanged="OnChanged" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="ReferencePanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Original tax invoice" FontWeight="SemiBold" />
                    <WrapPanel>
                        <StackPanel Width="170" Margin="0,0,8,0">
                            <TextBlock Text="Number" Style="{StaticResource Label}" />
                            <TextBox x:Name="ReferenceNumberInput" AutomationProperties.Name="Original invoice number" TextChanged="OnChanged" />
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,8,0">
                            <TextBlock Text="Date" Style="{StaticResource Label}" />
                            <DatePicker x:Name="ReferenceDateInput" AutomationProperties.Name="Original invoice date" SelectedDateChanged="OnChanged" />
                        </StackPanel>
                        <StackPanel Width="170">
                            <TextBlock Text="Value before VAT" Style="{StaticResource Label}" />
                            <TextBox x:Name="OriginalValueInput" AutomationProperties.Name="Value before VAT" TextChanged="OnChanged" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Original invoice type" Style="{StaticResource Label}" />
                    <ComboBox x:Name="ReferenceTypeInput" AutomationProperties.Name="Original invoice type" SelectionChanged="OnChanged" />
                    <TextBlock Text="Reason" Style="{StaticResource Label}" />
                    <ComboBox x:Name="ReasonInput" AutomationProperties.Name="Reason" SelectionChanged="OnReasonChanged" />
                    <TextBlock Text="Reason details" Style="{StaticResource Label}" />
                    <TextBox x:Name="ReasonDetailsInput" AutomationProperties.Name="Reason details" TextChanged="OnChanged" TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" IsEnabled="False" />
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Seller (your business, remembered)" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Name" Style="{StaticResource Label}" />
                        <TextBox x:Name="SellerName" AutomationProperties.Name="Seller name" TextChanged="OnChanged" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tax ID (13 digits)" Style="{StaticResource Label}" />
                                <TextBox x:Name="SellerId" AutomationProperties.Name="Seller tax ID" TextChanged="OnChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Branch" Style="{StaticResource Label}" />
                                <TextBox x:Name="SellerBranch" Text="00000" AutomationProperties.Name="Seller branch" TextChanged="OnChanged"
                                         ToolTip="00000 = head office" />
                            </StackPanel>
                        </Grid>
                        <views:ThaiAddressFields x:Name="SellerFields" Changed="OnAddressChanged" />
                        <TextBlock Text="Phone" Style="{StaticResource Label}" />
                        <TextBox x:Name="SellerPhone" AutomationProperties.Name="Seller phone" />
                        <TextBlock Text="Email" Style="{StaticResource Label}" />
                        <TextBox x:Name="SellerEmail" AutomationProperties.Name="Seller email" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Buyer" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Name" Style="{StaticResource Label}" />
                        <TextBox x:Name="BuyerName" AutomationProperties.Name="Buyer name" TextChanged="OnChanged" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Identified by" Style="{StaticResource Label}" />
                                <ComboBox x:Name="BuyerKind" AutomationProperties.Name="Buyer identified by" SelectionChanged="OnChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Number" Style="{StaticResource Label}" />
                                <TextBox x:Name="BuyerId" AutomationProperties.Name="Buyer number" TextChanged="OnChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Branch" Style="{StaticResource Label}" />
                                <TextBox x:Name="BuyerBranch" Text="00000" AutomationProperties.Name="Buyer branch" TextChanged="OnChanged" />
                            </StackPanel>
                        </Grid>
                        <RadioButton x:Name="BuyerStructured" Content="Thai address (separate fields)" IsChecked="True"
                                     GroupName="BuyerAddressMode" Margin="0,10,0,3" Checked="OnBuyerAddressModeChanged" />
                        <RadioButton x:Name="BuyerManual" Content="Type the address yourself" GroupName="BuyerAddressMode" Margin="0,0,0,3"
                                     Checked="OnBuyerAddressModeChanged" />
                        <views:ThaiAddressFields x:Name="BuyerFields" Changed="OnAddressChanged" />
                        <StackPanel x:Name="BuyerFreeAddress" Visibility="Collapsed">
                            <TextBlock Text="Address" Style="{StaticResource Label}" />
                            <TextBox x:Name="BuyerAddress" AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" AutomationProperties.Name="Buyer address" TextChanged="OnChanged" />
                            <TextBlock Text="Postcode" Style="{StaticResource Label}" />
                            <TextBox x:Name="BuyerPostcode" AutomationProperties.Name="Buyer postcode" TextChanged="OnChanged" />
                        </StackPanel>
                        <TextBlock Text="Email" Style="{StaticResource Label}" />
                        <TextBox x:Name="BuyerEmail" AutomationProperties.Name="Buyer email" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Items" FontWeight="SemiBold" Margin="0,16,0,4" />
                <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="140" RowHeight="26"
                          AutomationProperties.Name="Items" CellEditEnding="OnCellEditEnding" RowEditEnding="OnRowEditEnding" />
                <TextBlock Text="Type in the empty last row to add an item; select a row and press Delete to remove it." FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" />

                <TextBlock Text="Bill discount" Style="{StaticResource Label}" />
                <TextBox x:Name="BillDiscountInput" AutomationProperties.Name="Bill discount" TextChanged="OnChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="VAT %" VerticalAlignment="Center" />
                    <TextBox x:Name="VatInput" Width="50" Margin="6,0,16,0" Text="7" TextAlignment="Center" AutomationProperties.Name="VAT percent" TextChanged="OnChanged" />
                    <CheckBox x:Name="IncludesVatInput" Content="Prices include VAT" VerticalAlignment="Center" Click="OnChanged" />
                </StackPanel>
                <TextBlock Text="Note (optional)" Style="{StaticResource Label}" />
                <TextBox x:Name="NoteInput" AutomationProperties.Name="Note" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
