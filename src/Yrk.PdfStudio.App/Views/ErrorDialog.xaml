<Window x:Class="Yrk.PdfStudio.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Error" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" AutomationProperties.Name="Error">
    <StackPanel Margin="20">
        <DockPanel>
            <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" FontSize="24"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="MessageText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.Name="Error message" />
        </DockPanel>
        <TextBlock x:Name="NextStepText" Margin="0,14,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="What you can do:" />
        <TextBox x:Name="CodeText" Margin="0,12,0,0" FontSize="11" IsReadOnly="True"
                 BorderThickness="0" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}"
                 AutomationProperties.Name="Error code" />
        <Expander x:Name="DetailsExpander" Header="Details" IsExpanded="False" Margin="0,12,0,0"
                  AutomationProperties.Name="Details">
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200"
                     VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                     AutomationProperties.Name="Technical details" />
        </Expander>
        <TextBlock x:Name="CopyFeedback" Margin="0,12,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="Copy status" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyButton" Content="Copy info for problem report" Click="OnCopyClick"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" AutomationProperties.Name="Copy info for problem report" />
            <Button x:Name="OkButton" Grid.Column="1" Content="OK" IsDefault="True" IsCancel="True"
                    Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" AutomationProperties.Name="OK" />
        </Grid>
    </StackPanel>
</Window>
