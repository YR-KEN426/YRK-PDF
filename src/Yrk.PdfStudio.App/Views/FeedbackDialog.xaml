<Window x:Class="Yrk.PdfStudio.App.Views.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suggestions and problems"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource IconText}" Text="&#xED15;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Suggestions and problems" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"
                   Text="Tell us what to improve or what went wrong. The app sends nothing itself: each button opens your browser or email program, and you decide what to send." />
        <WrapPanel Margin="0,0,0,14">
            <TextBlock Text="Answers to common questions:" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,6,0" />
            <TextBlock x:Name="WebsiteText" />
        </WrapPanel>

        <Button x:Name="FormButton" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,8" Click="OnForm">
            <StackPanel>
                <TextBlock Text="Fill in the feedback form" FontWeight="SemiBold" />
                <TextBlock Text="A short online form. No account needed." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Button>
        <Button x:Name="EmailButton" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,8" Click="OnEmail">
            <StackPanel>
                <TextBlock Text="Send an email" FontWeight="SemiBold" />
                <TextBlock x:Name="EmailText" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Button>
        <Button x:Name="IssuesButton" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Padding="14,10" Click="OnIssues">
            <StackPanel>
                <TextBlock Text="Report on GitHub" FontWeight="SemiBold" />
                <TextBlock Text="For people with a GitHub account. Reports are public, so leave out private details." FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Button>

        <TextBlock Text="To help us find a problem" FontWeight="SemiBold" Margin="0,16,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                   Text="Say what you did and what happened, add a screenshot if you can, and paste the program information. If the app showed an error, the log file in the log folder helps too. Do not send documents with private information." />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Copy program information" Style="{StaticResource SecondaryButton}" Click="OnCopyInfo" />
            <Button Content="Open the log folder" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnLogs" />
        </StackPanel>
        <TextBlock x:Name="CopiedText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
