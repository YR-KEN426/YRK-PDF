<Window x:Class="Yrk.PdfStudio.App.Views.FileListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600"
        Height="520"
        MinWidth="480"
        MinHeight="380"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="Description" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="FileList" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3">
                            <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,10,0" Background="#F3F3F3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="110">
                <Button Content="Add files…" Style="{StaticResource SecondaryButton}" Click="OnAdd" />
                <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="OnRemove" />
                <Button x:Name="UpButton" Content="Move up" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="OnMoveUp" />
                <Button x:Name="DownButton" Content="Move down" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="OnMoveDown" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ImageOptions" Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Page size:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="PageSizeChoice" Width="240" SelectedIndex="0">
                <ComboBoxItem Content="A4 (fit image, 10 mm margin)" />
                <ComboBoxItem Content="Letter (fit image, 10 mm margin)" />
                <ComboBoxItem Content="Same as image (150 dpi)" />
            </ComboBox>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
