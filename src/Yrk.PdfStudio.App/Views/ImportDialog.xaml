<Window x:Class="Yrk.PdfStudio.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import data" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24">
        <TextBlock Text="Import data" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Choose a backup and enter its password to check its contents before importing." TextWrapping="Wrap" Margin="0,8,0,16" />
        <StackPanel x:Name="Inputs">
            <DockPanel>
                <Button Content="Choose backup…" Style="{StaticResource SecondaryButton}" Click="OnChoose" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <TextBox x:Name="FileInput" IsReadOnly="True" AutomationProperties.Name="Backup file" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Backup password" Margin="0,14,0,5" />
            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Backup password" Padding="6" MaxLength="1024" PasswordChanged="OnPasswordChanged" />
            <Button Content="Check contents" Style="{StaticResource SecondaryButton}" Click="OnInspect" HorizontalAlignment="Left" Margin="0,12,0,12" />
            <TextBlock Text="Backup contents" FontWeight="SemiBold" />
            <ListBox x:Name="Contents" Height="148" Margin="0,6,0,12" AutomationProperties.Name="Backup contents" />
            <CheckBox x:Name="ReplaceBox" Content="Replace existing settings (including stamps)" Margin="0,4" />
            <TextBlock Text="Without this option, existing JSON settings are kept. Duplicate signature images and Digital IDs are kept as separate copies. Stamps are merged only when this option is selected." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,12" />
        </StackPanel>
        <Border Background="#FFF4DC" BorderBrush="#CF9B36" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Your current data is backed up first" FontWeight="SemiBold" />
                <TextBlock Text="A before-import backup is saved in the app's Backups folder using the same password. If it cannot be created and verified, import stops. Empty stores need no backup." TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="The backup password cannot be recovered. Remember your Digital ID password too: each .pfx or .p12 file keeps its own password." TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RestartButton" Content="Restart now" Visibility="Collapsed" Style="{StaticResource SecondaryButton}" Click="OnRestart" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button x:Name="ImportButton" Content="Import data" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="OnImport" />
        </StackPanel>
    </StackPanel>
</Window>
