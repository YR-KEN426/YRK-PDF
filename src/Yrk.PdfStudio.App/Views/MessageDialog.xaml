<Window x:Class="Yrk.PdfStudio.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}"
        FontFamily="{DynamicResource UiFont}" TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="IconText" FontFamily="{DynamicResource IconFont}" FontSize="28"
                   Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,16,0" />
        <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
        <WrapPanel x:Name="Buttons" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </Grid>
</Window>
