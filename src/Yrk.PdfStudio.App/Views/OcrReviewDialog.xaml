<Window x:Class="Yrk.PdfStudio.App.Views.OcrReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review uncertain words" Width="1100" Height="800" MinWidth="900" MinHeight="560"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource SurfaceBrush}" FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnKeyDown" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <Border Background="{DynamicResource WarningBannerBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="ReviewWarningText" Text="Words in orange boxes are ones the program is not sure about. Check and fix them before saving. Words without a box can be wrong too, so read the text through again." FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Previous page" AutomationProperties.Name="Previous page" Style="{StaticResource SecondaryButton}" Click="OnPreviousPage" Margin="0,0,8,0" />
                <Button Content="Next page" AutomationProperties.Name="Next page" Style="{StaticResource SecondaryButton}" Click="OnNextPage" Margin="0,0,8,0" />
                <Button Content="Zoom out" AutomationProperties.Name="Zoom out" Style="{StaticResource SecondaryButton}" Click="OnZoomOut" Margin="0,0,8,0" />
                <Button Content="Zoom in" AutomationProperties.Name="Zoom in" Style="{StaticResource SecondaryButton}" Click="OnZoomIn" Margin="0,0,8,0" />
                <Button Content="Next word" AutomationProperties.Name="Next word" Style="{StaticResource SecondaryButton}" Click="OnNextWord" Margin="0,0,8,0" />
                <Button Content="Delete this word" AutomationProperties.Name="Delete this word" Style="{StaticResource SecondaryButton}" Click="OnDelete" IsEnabled="{Binding IsEditing}" />
            </WrapPanel>
            <TextBlock Text="Orange: uncertain · Blue: confirmed" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Enter confirms (empty deletes). Esc discards typing. Tab / Shift+Tab selects words. Ctrl+Tab reaches buttons." TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="Ctrl+S: save · Ctrl+K: skip remaining reviews · Ctrl+Delete: delete word · Alt+Left/Right: page" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding RemainingText}" FontWeight="SemiBold" Margin="0,0,24,0" />
                <TextBlock Text="{Binding PageText}" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="Skip review for remaining files" AutomationProperties.Name="Skip review for remaining files" Style="{StaticResource SecondaryButton}" Click="OnSkip" Margin="0,0,8,0" />
                <Button Content="Cancel this file" AutomationProperties.Name="Cancel this file" Style="{StaticResource SecondaryButton}" Click="OnCancel" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="Save" AutomationProperties.Name="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" MinWidth="90" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="True" Background="{DynamicResource ViewerBrush}" AutomationProperties.Name="Review page">
            <Grid Width="{Binding PageWidth}" Height="{Binding PageHeight}" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image Source="{Binding Image}" Stretch="Fill" IsHitTestVisible="False" />
                <Canvas x:Name="WordCanvas" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
