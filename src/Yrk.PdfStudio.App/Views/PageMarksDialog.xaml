<Window x:Class="Yrk.PdfStudio.App.Views.PageMarksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Yrk.PdfStudio.App.ViewModels"
        xmlns:conv="clr-namespace:Yrk.PdfStudio.App.Converters"
        Title="Watermark, header and footer"
        Width="1000"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Heading" TargetType="CheckBox">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Apply" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="OnApply" IsEnabled="{Binding CanApply}" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Text="A new copy is saved; the text in it can be searched and copied." />
        </DockPanel>

        <ScrollViewer DockPanel.Dock="Left" Width="400" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <StackPanel>
                <!-- One font for the watermark and the header and footer text -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Font" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Fonts}" IsEditable="True" Width="200" Text="{Binding FontFamilyName, UpdateSourceTrigger=PropertyChanged}"
                              Tag="keep-text" AutomationProperties.Name="Font" />
                </StackPanel>

                <!-- Watermark -->
                <CheckBox Content="Watermark" Style="{StaticResource Heading}" Margin="0,0,0,6" IsChecked="{Binding UseWatermark}" />
                <StackPanel IsEnabled="{Binding UseWatermark}" Margin="22,0,0,0">
                    <TextBox Text="{Binding Watermark, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Watermark text" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Size" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="Fit the page" IsChecked="{Binding AutoSize}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding WatermarkSize, UpdateSourceTrigger=LostFocus}" Width="56" Margin="12,0,4,0" AutomationProperties.Name="Watermark size" />
                            <TextBlock Text="pt" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Colour" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Width="140" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Colors}" SelectedItem="{Binding WatermarkColor}" AutomationProperties.Name="Watermark colour" />
                        <TextBlock Grid.Row="2" Text="Opacity" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Slider Minimum="5" Maximum="100" Width="180" Value="{Binding OpacityPercent}" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Opacity" />
                            <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:0} %}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Angle" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Width="140" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Angles}" SelectedItem="{Binding Angle}" ItemStringFormat="{}{0}°" AutomationProperties.Name="Angle" />
                    </Grid>
                    <CheckBox Content="Behind the page content" IsChecked="{Binding Behind}" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Header and footer -->
                <CheckBox Content="Header, footer and page numbers" Style="{StaticResource Heading}" Margin="0,18,0,6" IsChecked="{Binding UseHeaderFooter}" />
                <StackPanel IsEnabled="{Binding UseHeaderFooter}" Margin="22,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Text="Left" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Grid.Column="2" Text="Centre" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="3" Text="Right" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0" />
                        <TextBlock Grid.Row="1" Text="Header" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding HeaderLeft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Header left" />
                        <TextBox Grid.Row="1" Grid.Column="2" Margin="4,4,0,0" Text="{Binding HeaderCenter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Header centre" />
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="4,4,0,0" Text="{Binding HeaderRight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Header right" />
                        <TextBlock Grid.Row="2" Text="Footer" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Text="{Binding FooterLeft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Footer left" />
                        <TextBox Grid.Row="2" Grid.Column="2" Margin="4,4,0,0" Text="{Binding FooterCenter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Footer centre" />
                        <TextBox Grid.Row="2" Grid.Column="3" Margin="4,4,0,0" Text="{Binding FooterRight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Footer right" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0"
                               Text="{}{page} page number · {pages} number of pages · {date} today · {file} file name" />

                    <TextBlock Text="Page numbers (footer centre)" Margin="0,10,0,4" />
                    <ItemsControl ItemsSource="{Binding NumberPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,6,6"
                                        Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Converter={x:Static conv:PagePresetConverter.Instance}}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Text size" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="80" HorizontalAlignment="Left" ItemsSource="{Binding TextSizes}" SelectedItem="{Binding TextSize}"
                                  ItemStringFormat="{}{0} pt" AutomationProperties.Name="Text size" />
                        <TextBlock Grid.Row="1" Text="Colour" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,6,0,0"
                                  ItemsSource="{Binding Colors}" SelectedItem="{Binding TextColor}" AutomationProperties.Name="Text colour" />
                        <TextBlock Grid.Row="2" Text="Margin" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox Text="{Binding MarginMm, UpdateSourceTrigger=LostFocus}" Width="56" AutomationProperties.Name="Margin" />
                            <TextBlock Text="mm from the edge" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="First number" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FirstNumber, UpdateSourceTrigger=LostFocus}" Width="56" HorizontalAlignment="Left"
                                 Margin="0,6,0,0" AutomationProperties.Name="First number" />
                    </Grid>
                </StackPanel>

                <CheckBox Content="Leave the first page as it is (cover page)" IsChecked="{Binding SkipFirstPage}" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous preview page">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" />
                </Button>
                <TextBlock Text="{Binding PreviewText}" VerticalAlignment="Center" Margin="6,0" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding NextPageCommand}" AutomationProperties.Name="Next preview page">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE76C;" />
                </Button>
            </StackPanel>
            <Border Background="#E9E9E9" Padding="16">
                <Viewbox Stretch="Uniform">
                    <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="0.5">
                        <Grid Width="{Binding PageWidth}" Height="{Binding PageHeight}" ClipToBounds="True">
                            <Image Source="{Binding PreviewImage}" Stretch="Fill" />
                            <ItemsControl ItemsSource="{Binding PreviewMarks}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PreviewMark}">
                                        <TextBlock Text="{Binding Text}" FontFamily="{Binding Font}" FontSize="{Binding FontSize}" FontWeight="{Binding Weight}"
                                                   Foreground="{Binding Brush}" Opacity="{Binding Opacity}" TextOptions.TextFormattingMode="Ideal">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Viewbox>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
