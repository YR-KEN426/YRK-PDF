<Window x:Class="Yrk.PdfStudio.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="This document is protected" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
        <PasswordBox x:Name="PasswordInput" Padding="6,5" />
        <TextBlock x:Name="ErrorText" Text="Incorrect password. Please try again." Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="Open" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
