<Window x:Class="Yrk.PdfStudio.App.Views.PrivacyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy and safety"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Read the full privacy policy" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnReadPrivacyPolicy" />
            <Button Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
        <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Privacy and safety" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Style="{StaticResource Heading}" Text="Your documents stay on this computer" />
                <TextBlock Style="{StaticResource Body}" Text="YRK PDF works offline. Files are never uploaded: there is no cloud, no account and no sign-in." />
                <TextBlock Style="{StaticResource Body}" Text="No AI services: your documents are never sent to an AI or cloud service. Text recognition (OCR) runs entirely on this computer." />
                <TextBlock Style="{StaticResource Body}" Text="No tracking: no usage statistics, no advertising, no crash reports sent anywhere. Errors are written only to a log file on this computer." />

                <TextBlock Style="{StaticResource Heading}" Text="The only times it uses the internet" />
                <TextBlock Style="{StaticResource Body}" x:Name="UpdatesText" />
                <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically" Margin="16,6,0,4" FontWeight="SemiBold"
                          Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" AutomationProperties.Name="Automatic updates" />
                <TextBlock Style="{StaticResource Body}" Text="2. Text recognition (OCR): every language, including English, is downloaded once from the Tesseract project on GitHub after you confirm." />
                <TextBlock Style="{StaticResource Body}" Text="3. Digital signatures, only if you tick &quot;Add a trusted timestamp&quot; or &quot;Add long-term validation data&quot; when signing: a fingerprint (hash) of the signature is sent to the timestamp server, and the revocation lists named in the certificates are downloaded from their issuers. The document itself is not sent." />
                <TextBlock Style="{StaticResource Body}" Text="4. Opening a PDF signed with a certificate from an authority trusted by Windows: Windows may ask that authority whether the certificate has been revoked. The document is not sent." />

                <TextBlock Style="{StaticResource Heading}" Text="What is kept on this computer" />
                <TextBlock Style="{StaticResource Body}" Text="Settings, recent file names and folders, stamps, e-Tax seller data and OCR language files stay here. Saved signature images are encrypted with Windows for your account; Digital IDs are password-protected." />
                <TextBlock Style="{StaticResource Body}" Text="Recovery copies of unsaved documents are deleted on save, cancel or normal close. Temporary files in the Windows Temp folder are deleted on close, or at the next start after an abnormal close." />
                <TextBlock Style="{StaticResource Body}" Text="The local error log may contain file or folder names. It is never sent anywhere, is limited to 1 MB per day and is deleted after 14 days." />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ClearRecentButton" Content="Clear recent files" Style="{StaticResource SecondaryButton}" Click="OnClearRecent" />
                    <Button Content="Open the data folder" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnOpenFolder" />
                </StackPanel>

                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,14,0,0"
                           Text="Uninstalling the app does not delete its data folder. Open the data folder to delete files you no longer need." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
