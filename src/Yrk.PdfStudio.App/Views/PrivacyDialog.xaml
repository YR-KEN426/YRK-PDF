<Window x:Class="Yrk.PdfStudio.App.Views.PrivacyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy and safety"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="22" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Privacy and safety" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Style="{StaticResource Heading}" Text="Your documents stay on this computer" />
        <TextBlock Style="{StaticResource Body}" Text="YRK PDF works offline. Files are never uploaded: there is no cloud, no account and no sign-in." />
        <TextBlock Style="{StaticResource Body}" Text="No AI services: your documents are never sent to an AI or cloud service. Text recognition (OCR) runs on this computer with the open-source Tesseract engine and its built-in recognition model." />
        <TextBlock Style="{StaticResource Body}" Text="No tracking: no usage statistics, no advertising, no crash reports sent anywhere. Errors are written only to a log file on this computer." />

        <TextBlock Style="{StaticResource Heading}" Text="The only times it uses the internet" />
        <TextBlock Style="{StaticResource Body}" x:Name="UpdatesText" />
        <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically" Margin="16,6,0,4" FontWeight="SemiBold"
                  Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" AutomationProperties.Name="Automatic updates" />
        <TextBlock Style="{StaticResource Body}" Text="2. Text recognition languages: when you choose a language that is not on this computer yet, its data file is downloaded once from the Tesseract project on GitHub." />
        <TextBlock Style="{StaticResource Body}" Text="3. Digital signatures, only if you tick &quot;Add a trusted timestamp&quot; when signing: a fingerprint (hash) of the signature is sent to the timestamp server. The document itself is not sent." />
        <TextBlock Style="{StaticResource Body}" Text="4. Opening a digitally signed PDF whose certificate comes from a trusted authority: Windows asks that authority whether the certificate has been revoked. The document is not sent." />

        <TextBlock Style="{StaticResource Heading}" Text="What is kept on this computer" />
        <TextBlock Style="{StaticResource Body}" Text="Settings, the list of recent files (names and folders only), and saved signatures, which are encrypted with Windows so only your Windows account can read them. Digital IDs you create or import are kept as password-protected files in the app's folder." />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ClearRecentButton" Content="Clear recent files" Style="{StaticResource SecondaryButton}" Click="OnClearRecent" />
            <Button Content="Open the data folder" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnOpenFolder" />
        </StackPanel>

        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,14,0,0"
                   Text="Built only from open-source components with permissive licences (listed in About). Removing the app with Windows Settings ▸ Apps removes the program; the data folder can be deleted by hand." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
