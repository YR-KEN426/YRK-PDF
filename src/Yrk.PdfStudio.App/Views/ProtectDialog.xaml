<Window x:Class="Yrk.PdfStudio.App.Views.ProtectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protect with password"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Protect with password" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12"
                   Text="The document is encrypted with AES-256. Keep the passwords safe: nobody, including YRK, can recover them." />

        <CheckBox x:Name="OpenBox" Content="Require a password to open the document" FontWeight="SemiBold" IsChecked="True" Checked="OnChanged" Unchecked="OnChanged" />
        <Grid x:Name="OpenPanel" Margin="24,6,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Password" VerticalAlignment="Center" />
            <PasswordBox x:Name="OpenPassword" Grid.Column="1" AutomationProperties.Name="Open password" PasswordChanged="OnChanged" />
            <TextBlock Grid.Row="1" Text="Confirm password" VerticalAlignment="Center" Margin="0,6,0,0" />
            <PasswordBox x:Name="OpenConfirm" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" AutomationProperties.Name="Confirm open password" PasswordChanged="OnChanged" />
        </Grid>

        <CheckBox x:Name="RestrictBox" Content="Restrict printing, copying and changes" FontWeight="SemiBold" Margin="0,8,0,3" Checked="OnChanged" Unchecked="OnChanged" />
        <StackPanel x:Name="RestrictPanel" Margin="24,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Owner password" VerticalAlignment="Center" />
                <PasswordBox x:Name="OwnerPassword" Grid.Column="1" AutomationProperties.Name="Owner password" PasswordChanged="OnChanged" />
                <TextBlock Grid.Row="1" Text="Confirm password" VerticalAlignment="Center" Margin="0,6,0,0" />
                <PasswordBox x:Name="OwnerConfirm" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" AutomationProperties.Name="Confirm owner password" PasswordChanged="OnChanged" />
            </Grid>
            <TextBlock Text="Anyone who opens the document may:" Margin="0,10,0,4" />
            <CheckBox x:Name="AllowPrint" Content="Print" IsChecked="True" />
            <CheckBox x:Name="AllowCopy" Content="Copy text and images" />
            <CheckBox x:Name="AllowFillForms" Content="Fill in forms and sign" IsChecked="True" />
            <CheckBox x:Name="AllowComments" Content="Add comments" />
            <CheckBox x:Name="AllowModify" Content="Change the content" />
            <CheckBox x:Name="AllowAssemble" Content="Insert, delete, rotate and extract pages" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0"
                       Text="Screen readers can always read the text. The owner password lifts these limits." />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,0"
                   Text="A new copy is saved. Digital signatures in it will no longer be valid." />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Protection error" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Protect" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
