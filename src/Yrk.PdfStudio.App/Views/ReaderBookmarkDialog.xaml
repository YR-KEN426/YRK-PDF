<Window x:Class="Yrk.PdfStudio.App.Views.ReaderBookmarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reading marks" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Reading marks" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Label Target="{Binding ElementName=NameInput}" Padding="0,0,0,4">
                <TextBlock Text="Name (up to 40 characters)" TextWrapping="Wrap" />
            </Label>
            <TextBox x:Name="NameInput" MaxLength="40" Padding="6,5" AutomationProperties.Name="Reading mark name" />
            <TextBlock Text="Colour" Margin="0,12,0,4" />
            <!-- Keep the selector name, tags and SelectedValue used by the existing answer code. -->
            <ListBox x:Name="ColourInput" SelectedValuePath="Tag" AutomationProperties.Name="Reading mark colour"
                     Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource ColorRing}">
                        <Setter Property="GroupName" Value="ReadingMarkColour" />
                        <Setter Property="IsChecked" Value="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                    </Style>
                </ListBox.Resources>
                <ListBoxItem Tag="red"><RadioButton Background="Crimson" ToolTip="Red" AutomationProperties.Name="Red" /></ListBoxItem>
                <ListBoxItem Tag="orange"><RadioButton Background="DarkOrange" ToolTip="Orange" AutomationProperties.Name="Orange" /></ListBoxItem>
                <ListBoxItem Tag="yellow"><RadioButton Background="Gold" ToolTip="Yellow" AutomationProperties.Name="Yellow" /></ListBoxItem>
                <ListBoxItem Tag="green"><RadioButton Background="SeaGreen" ToolTip="Green" AutomationProperties.Name="Green" /></ListBoxItem>
                <ListBoxItem Tag="blue"><RadioButton Background="DodgerBlue" ToolTip="Blue" AutomationProperties.Name="Blue" /></ListBoxItem>
                <ListBoxItem Tag="purple"><RadioButton Background="MediumPurple" ToolTip="Purple" AutomationProperties.Name="Purple" /></ListBoxItem>
            </ListBox>
            <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OnRemove" />
                <Button x:Name="OkButton" Content="Add" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="70" Margin="0,0,8,8" Click="OnOk" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="70" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
