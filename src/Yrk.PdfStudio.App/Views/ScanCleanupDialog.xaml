<Window x:Class="Yrk.PdfStudio.App.Views.ScanCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean up scan"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <TextBlock Text="Clean up the scanned pages" FontSize="16" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,14"
                   Text="This is what was found. Untick anything you want to keep as it is. Undo (Ctrl+Z) puts everything back." />
        <CheckBox x:Name="StraightenOption" IsChecked="True" Click="OnChanged">
            <TextBlock x:Name="StraightenText" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox x:Name="EdgesOption" IsChecked="True" Margin="0,10,0,0" Click="OnChanged">
            <TextBlock x:Name="EdgesText" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox x:Name="BlankOption" IsChecked="True" Margin="0,10,0,0" Click="OnChanged">
            <TextBlock x:Name="BlankText" TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="Clean up" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
