<Window x:Class="Yrk.PdfStudio.App.Views.ScanCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop scanned page" Width="800" Height="720" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Drag the corners or edges to crop. Drag inside the frame to move it." TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Canvas x:Name="PageCanvas" Background="White" MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp">
                <Image x:Name="PageImage"/>
                <Rectangle x:Name="Frame" Stroke="#0078D4" StrokeThickness="3" Fill="#200078D4"/>
                <Rectangle x:Name="TopLeft" Width="12" Height="12" Fill="#0078D4"/>
                <Rectangle x:Name="TopRight" Width="12" Height="12" Fill="#0078D4"/>
                <Rectangle x:Name="BottomLeft" Width="12" Height="12" Fill="#0078D4"/>
                <Rectangle x:Name="BottomRight" Width="12" Height="12" Fill="#0078D4"/>
            </Canvas>
        </Viewbox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Apply" Style="{StaticResource PrimaryButton}" Click="OnApply" Margin="0,0,8,0"/>
            <Button Content="Clear crop" Style="{StaticResource SecondaryButton}" Click="OnClear" Margin="0,0,8,0"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
