<Window x:Class="Yrk.PdfStudio.App.Views.ScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan to PDF" Width="1160" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnKeyDown"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="PresetChip" TargetType="RadioButton" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="GroupName" Value="ScanPresets"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Chip" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                        BorderBrush="{StaticResource TextBrush}" BorderThickness="0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolSeparator" TargetType="Separator">
            <Setter Property="Width" Value="1"/><Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                <Border Background="{TemplateBinding Background}"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="Editor">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Scanner" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="Devices" Width="240" DisplayMemberPath="Name" SelectionChanged="OnDeviceChanged"/>
                    <Button Content="Find scanners again" Click="OnFind" Style="{StaticResource ToolbarButton}" Margin="6,0,12,0"/>
                    <TextBlock Text="Paper source" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="Sources" Width="150" DisplayMemberPath="Text" SelectedValuePath="Value" HorizontalAlignment="Left" SelectionChanged="OnSourceChanged"/>
                    <Button x:Name="GlassButton" Content="Preview glass" Click="OnGlassPreview" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0"/>
                </DockPanel>
                <WrapPanel x:Name="PresetRow" Margin="0,0,0,8">
                    <RadioButton Tag="BlackAndWhiteDocument" Content="B&amp;W document" Click="OnPreset" Style="{StaticResource PresetChip}"/>
                    <RadioButton Tag="ColorDocument" Content="Color document" Click="OnPreset" Style="{StaticResource PresetChip}"/>
                    <RadioButton Tag="Receipt" Content="Receipt" Click="OnPreset" Style="{StaticResource PresetChip}"/>
                    <RadioButton Tag="TwoSidedCard" Content="Two-sided card" Click="OnPreset" Style="{StaticResource PresetChip}"/>
                    <RadioButton Tag="Photo" Content="Photo" Click="OnPreset" Style="{StaticResource PresetChip}"/>
                    <RadioButton Tag="Custom" Content="Custom" Click="OnPreset" Style="{StaticResource PresetChip}"/>
                </WrapPanel>
            </StackPanel>
            <Expander x:Name="MoreSettings" Grid.Row="1" Header="More settings" Margin="0,0,0,10">
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Color mode" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="Colors" Width="140" DisplayMemberPath="Text" SelectedValuePath="Value" SelectionChanged="OnColorChanged"/>
                    <TextBlock Text="DPI" VerticalAlignment="Center" Margin="12,0,8,0"/><ComboBox x:Name="Dpi" Width="80"/>
                    <TextBlock Text="Paper size" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <ComboBox x:Name="PaperSize" Width="250" SelectedValuePath="Tag" SelectionChanged="OnPaperChanged"/>
                    <StackPanel x:Name="CustomPaperPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="CustomWidth" Width="55" Text="210" ToolTip="Width"/>
                        <TextBlock Text="×" Margin="4,0"/>
                        <TextBox x:Name="CustomHeight" Width="55" Text="297" ToolTip="Height"/>
                        <ComboBox x:Name="CustomUnit" Width="65" SelectedIndex="0"><ComboBoxItem Content="mm"/><ComboBoxItem Content="inch"/></ComboBox>
                    </StackPanel>
                    <TextBlock Text="JPEG quality" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <Slider x:Name="Quality" Width="100" Minimum="50" Maximum="95" Value="80" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElementName=Quality, Path=Value, StringFormat={}{0:0}}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Apply settings" Click="OnApplySettings" Style="{StaticResource ToolbarButton}" Margin="12,0,0,0"/>
                </WrapPanel>
            </Expander>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="Clear scan area" Click="OnClearArea" Padding="8,4" Margin="6,0,6,6" HorizontalAlignment="Stretch"/>
                        <ListBox x:Name="PageList" HorizontalContentAlignment="Stretch" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True" PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove" Drop="OnDrop">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel Margin="6">
                                    <Border Width="120" Height="145">
                                        <Border BorderBrush="#C9CDD4" BorderThickness="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding Thumbnail}" MaxWidth="118" MaxHeight="143" Stretch="Uniform"/>
                                        </Border>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Number}"/><TextBlock Text="{Binding Blank}" Foreground="#8A6500" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="+" ToolTip="Scan more" Click="OnAppend" Height="65" Margin="2,8" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel x:Name="PageTools" Margin="0,0,0,8">
                        <Button Content="Rotate left" Click="OnLeft" ToolTip="Rotate left (Shift+R)" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Rotate right" Click="OnRight" ToolTip="Rotate right (R)" Style="{StaticResource ToolbarButton}"/>
                        <Separator Style="{StaticResource ToolSeparator}"/>
                        <Button x:Name="CropButton" Content="Crop" Click="OnCrop" ToolTip="Crop (C)" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Auto adjust" Click="OnAutoCrop" ToolTip="Auto adjust (A)" Style="{StaticResource ToolbarButton}"/>
                        <Separator Style="{StaticResource ToolSeparator}"/>
                        <Button Content="Remove" Click="OnRemove" ToolTip="Remove (Delete)" Style="{StaticResource ToolbarButton}"/>
                        <Separator Style="{StaticResource ToolSeparator}"/>
                        <Button x:Name="UndoButton" Content="Undo" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource ToolbarButton}"/>
                        <Button x:Name="RedoButton" Content="Redo" Click="OnRedo" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource ToolbarButton}"/>
                        <Separator Style="{StaticResource ToolSeparator}"/>
                        <Button Content="Fit" Click="OnFit" ToolTip="Fit (F)" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="100%" Click="OnActualSize" ToolTip="100% (Ctrl+1)" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="−" Click="OnZoomOut" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out" Style="{StaticResource ToolbarButton}"/>
                        <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Margin="4,0"/>
                        <Button Content="+" Click="OnZoomIn" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" Style="{StaticResource ToolbarButton}"/>
                    </WrapPanel>
                    <Border Grid.Row="1" Background="#E5E7EB" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ScrollBar x:Name="HorizontalPan" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed" ValueChanged="OnScrollPan" SmallChange="48"/>
                            <ScrollBar x:Name="VerticalPan" Grid.Column="1" Orientation="Vertical" Visibility="Collapsed" ValueChanged="OnScrollPan" SmallChange="48"/>
                            <Canvas x:Name="PreviewScroll" Background="Transparent" ClipToBounds="True" SizeChanged="OnPreviewSizeChanged"
                                    MouseWheel="OnPreviewWheel" MouseDown="OnCropDown" MouseMove="OnCropMove" MouseUp="OnCropUp" LostMouseCapture="OnPreviewCaptureLost">
                                    <Canvas x:Name="PageCanvas" IsHitTestVisible="False">
                                        <Image x:Name="PageImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Image x:Name="RegionImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Canvas>
                                    <Canvas x:Name="CropOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                                        <Path x:Name="CropShade" Fill="#80000000"/>
                                        <Rectangle x:Name="CropFrame" Stroke="#2563EB" StrokeThickness="2" Visibility="Collapsed"/>
                                        <Line x:Name="SnapGuideX" Stroke="#2563EB" StrokeThickness="1" StrokeDashArray="4,4" Visibility="Collapsed"/>
                                        <Line x:Name="SnapGuideY" Stroke="#2563EB" StrokeThickness="1" StrokeDashArray="4,4" Visibility="Collapsed"/>
                                        <Canvas x:Name="CropHandles"/>
                                        <TextBlock x:Name="CropSize" Background="#F0FFFFFF" Padding="5,2"/>
                                    </Canvas>
                            </Canvas>
                            <TextBlock x:Name="PreviewBusy" Text="Updating preview…" Opacity="0.7" Margin="12" Padding="6,3"
                                       Background="#EFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <TextBlock x:Name="EmptyHint" Text="Place a document on the glass, then press Scan" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" FontSize="18"/>
                        </Grid>
                    </Border>
                    <Border x:Name="CropPanel" Grid.Row="2" Padding="8" Margin="0,8,0,0" Background="#F3F4F6" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="CropPurpose" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Hold Space and drag to pan the image" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <TextBlock Text="Left" VerticalAlignment="Center"/><TextBox x:Name="CropLeft" Width="78" Margin="4" TextChanged="OnCropNumberChanged" LostFocus="OnCropNumberCommit" KeyDown="OnCropNumberKey" AutomationProperties.Name="Left"/>
                                <TextBlock Text="Top" VerticalAlignment="Center"/><TextBox x:Name="CropTop" Width="78" Margin="4" TextChanged="OnCropNumberChanged" LostFocus="OnCropNumberCommit" KeyDown="OnCropNumberKey" AutomationProperties.Name="Top"/>
                                <TextBlock Text="Width" VerticalAlignment="Center"/><TextBox x:Name="CropWidth" Width="78" Margin="4" TextChanged="OnCropNumberChanged" LostFocus="OnCropNumberCommit" KeyDown="OnCropNumberKey" AutomationProperties.Name="Width"/>
                                <TextBlock Text="Height" VerticalAlignment="Center"/><TextBox x:Name="CropHeight" Width="78" Margin="4" TextChanged="OnCropNumberChanged" LostFocus="OnCropNumberCommit" KeyDown="OnCropNumberKey" AutomationProperties.Name="Height"/>
                                <TextBlock x:Name="CropUnits" VerticalAlignment="Center" Margin="4"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Aspect ratio" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CropAspectChoice" Width="120" SelectedIndex="0" SelectionChanged="OnCropAspectChanged" AutomationProperties.Name="Aspect ratio">
                                    <ComboBoxItem Content="Free"/><ComboBoxItem Content="Paper size"/><ComboBoxItem Content="Original"/>
                                </ComboBox>
                                <Button Content="Apply" Click="OnCropApply" Margin="8,0,0,0" Padding="10,4"/>
                                <Button Content="Reset" Click="OnCropReset" Margin="8,0,0,0" Padding="10,4"/>
                                <Button Content="Cancel" Click="OnCropCancel" Margin="8,0,0,0" Padding="10,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Column="4" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10">
                    <StackPanel x:Name="AdjustmentPanel">
                        <TextBlock Text="Apply to:" FontWeight="SemiBold"/>
                        <WrapPanel x:Name="ScopeRow" Margin="0,6,0,8">
                            <RadioButton Tag="ThisPage" Content="This page" GroupName="AdjustmentScope" Click="OnScope" Style="{StaticResource PresetChip}" Padding="5,4"/>
                            <RadioButton x:Name="SelectedScope" Tag="Selected" GroupName="AdjustmentScope" Click="OnScope" Style="{StaticResource PresetChip}" Padding="5,4"/>
                            <RadioButton Tag="AllPages" Content="All pages" GroupName="AdjustmentScope" Click="OnScope" Style="{StaticResource PresetChip}" Padding="5,4"/>
                        </WrapPanel>
                        <TextBlock Text="Adjust page" FontWeight="SemiBold"/>
                        <TextBlock Text="Brightness" Margin="0,12,0,0"/>
                        <Slider PreviewMouseLeftButtonDown="OnAdjustmentStart" PreviewMouseLeftButtonUp="OnAdjustmentEnd" LostMouseCapture="OnAdjustmentEnd" PreviewKeyDown="OnAdjustmentKeyStart" PreviewKeyUp="OnAdjustmentKeyEnd" LostKeyboardFocus="OnAdjustmentEnd" x:Name="Brightness" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnAdjustmentChanged"/>
                        <TextBlock Text="{Binding ElementName=Brightness, Path=Value, StringFormat={}{0:+0;-0;0}}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Contrast" Margin="0,12,0,0"/>
                        <Slider PreviewMouseLeftButtonDown="OnAdjustmentStart" PreviewMouseLeftButtonUp="OnAdjustmentEnd" LostMouseCapture="OnAdjustmentEnd" PreviewKeyDown="OnAdjustmentKeyStart" PreviewKeyUp="OnAdjustmentKeyEnd" LostKeyboardFocus="OnAdjustmentEnd" x:Name="Contrast" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnAdjustmentChanged"/>
                        <TextBlock Text="{Binding ElementName=Contrast, Path=Value, StringFormat={}{0:+0;-0;0}}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sharpness" Margin="0,12,0,0"/>
                        <Slider PreviewMouseLeftButtonDown="OnAdjustmentStart" PreviewMouseLeftButtonUp="OnAdjustmentEnd" LostMouseCapture="OnAdjustmentEnd" PreviewKeyDown="OnAdjustmentKeyStart" PreviewKeyUp="OnAdjustmentKeyEnd" LostKeyboardFocus="OnAdjustmentEnd" x:Name="Sharpness" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnAdjustmentChanged"/>
                        <TextBlock Text="{Binding ElementName=Sharpness, Path=Value, StringFormat={}{0:+0;-0;0}}" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="WhiteBackground" Content="White background" Margin="0,12,0,0" Checked="OnAdjustmentChanged" Unchecked="OnAdjustmentChanged"/>
                        <CheckBox x:Name="Straighten" Content="Straighten" Margin="0,12,0,12" Checked="OnAdjustmentChanged" Unchecked="OnAdjustmentChanged"/>
                        <CheckBox x:Name="AutoOrientation" Content="Auto rotate to text orientation" Margin="0,0,0,12" Checked="OnOrientationChanged" Unchecked="OnOrientationChanged">
                            <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="190"/></DataTemplate></CheckBox.ContentTemplate>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="NoticeBand" Grid.Row="1" Background="#FFF3CD" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#654C00"/>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="Message" TextWrapping="Wrap"/>
            <Expander x:Name="ErrorDetails" Header="Details" FontSize="11" Visibility="Collapsed">
                <TextBlock x:Name="ErrorCode" TextWrapping="Wrap"/>
            </Expander>
            <DockPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,8,0,0">
                <Button Content="Cancel" DockPanel.Dock="Right" Click="OnCancel" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                <ProgressBar IsIndeterminate="True" Height="6"/>
            </DockPanel>
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="ScanButton" Content="Scan" Click="OnScan" Style="{StaticResource PrimaryButton}" Margin="0,0,14,0"/>
            <Button x:Name="CancelCardButton" Content="Cancel card" Click="OnCancelCard" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
            <Button x:Name="CloseButton" Content="Close" DockPanel.Dock="Right" Click="OnClose" Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="CreateButton" Content="Save PDF" DockPanel.Dock="Right" Click="OnCreate" Style="{StaticResource SecondaryButton}" Margin="8,0"/>
            <ComboBox x:Name="OutputFormat" DockPanel.Dock="Right" Width="85" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="OnOutputFormatChanged">
                <ComboBoxItem Tag="Pdf" Content="PDF"/><ComboBoxItem Tag="Jpeg" Content="JPEG"/><ComboBoxItem Tag="Png" Content="PNG"/>
            </ComboBox>
            <TextBlock x:Name="SizeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/>
            <CheckBox x:Name="Ocr" Content="Searchable text (OCR)" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
