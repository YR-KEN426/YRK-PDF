<Window x:Class="Yrk.PdfStudio.App.Views.SignAgainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign with a digital ID"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20">
        <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
        <TextBlock x:Name="UnsavedText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="You have unsaved changes. Earlier signatures will show as edited after signing." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Continue signing" Style="{StaticResource PrimaryButton}" Click="OnContinue" />
            <Button Content="Cancel" IsCancel="True" IsDefault="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
