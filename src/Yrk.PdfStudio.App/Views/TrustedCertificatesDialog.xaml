<Window x:Class="Yrk.PdfStudio.App.Views.TrustedCertificatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My trusted certificates" Width="640" Height="440" MinWidth="500" MinHeight="320"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="This trust applies only in YRK on this computer. Other programs may still show an unknown signer."
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Import .cer / .crt…" Style="{StaticResource SecondaryButton}" Click="OnImport" />
            <Button Content="Certificate" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnView" />
            <Button Content="Delete" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnDelete" />
            <Button Content="Close" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </WrapPanel>
        <ListBox x:Name="CertificateList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="My trusted certificates">
            <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="4,6" /></DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
