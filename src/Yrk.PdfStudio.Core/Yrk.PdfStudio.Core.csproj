<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Yrk.PdfStudio.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yrk.PdfStudio.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pdf\ETax\thai-areas.txt" LogicalName="Yrk.PdfStudio.Core.Pdf.ETax.thai-areas.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prebuilt PDFium binaries (BSD-3/Apache-2.0) for win-x64, win-x86 and win-arm64. -->
    <PackageReference Include="ACadSharp" Version="3.8.0" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8100" />
    <!--
      PDFsharp (compression). Pinned to 6.2.4, the last MIT release: 6.5.0 and later are AGPL-3.0 with a
      runtime license check, which would oblige YRK PDF to publish its source. Do not upgrade.
    -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <!-- Overrides the vulnerable 8.0.x version PDFsharp depends on (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

</Project>
