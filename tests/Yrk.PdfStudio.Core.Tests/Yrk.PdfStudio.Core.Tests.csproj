<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows + WPF so tests can use the app's real JPEG encoder and imaging helpers. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yrk.PdfStudio.Core\Yrk.PdfStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\Yrk.PdfStudio.App\Yrk.PdfStudio.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\sample.pdf" Link="Assets\sample.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
